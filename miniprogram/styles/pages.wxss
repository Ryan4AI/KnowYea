/* pages.wxss — 通用页面样式：画像收集页 + 课程生成页共享 */

/* 页面基础 */
.page {
  background: var(--capsule-bg);
  min-height: 100vh;
}
.page-container {
  padding-bottom: 40rpx;
}

/* 页面头部 */
.page-header {
  text-align: center;
  padding: 80rpx 40rpx 40rpx;
}
.page-icon { font-size: 64rpx; margin-bottom: 16rpx; }
.page-title { font-size: 34rpx; font-weight: 600; color: var(--capsule-ink); margin-bottom: 8rpx; }
.page-desc { font-size: 26rpx; color: #999; }

/* 白卡片 */
.white-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  margin: 0 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}
.white-card.centered { text-align: center; }
.white-card.narrow {
  width: 100%;
  max-width: 640rpx;
  margin-left: auto;
  margin-right: auto;
}

/* 按钮 */
.btn-primary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--capsule-accent);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  text-align: center;
  border: none;
}
.btn-primary[disabled] {
  background: #d1d5db;
  color: #999;
}

.btn-secondary {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: var(--capsule-bg);
  color: #666;
  font-size: 28rpx;
  border-radius: 16rpx;
  margin-top: 16rpx;
  text-align: center;
  border: none;
}

/* 表单基础（画像页 + 其他表单页用） */
.form-group { margin-bottom: 28rpx; }
.form-label { display: block; font-size: 28rpx; color: #555; margin-bottom: 12rpx; }
.form-hint { font-size: 24rpx; color: #aaa; font-weight: normal; }

.picker-field {
  background: var(--capsule-bg);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
}

/* 标签基础 */
.tag-list { display: flex; flex-wrap: wrap; gap: 12rpx; }
.tag-item {
  background: var(--capsule-bg);
  border-radius: 30rpx;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #666;
}
.tag-item.selected { background: var(--capsule-accent); color: #fff; }
