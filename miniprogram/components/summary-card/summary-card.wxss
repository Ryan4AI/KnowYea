.summary-card {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 16rpx 0;
}

.summary-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 12rpx;
}

.summary-text {
  font-size: 28rpx;
  color: white;
  line-height: 1.6;
}