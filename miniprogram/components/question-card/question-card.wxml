<!-- components/question-card/question-card.wxml -->
<view class="question-card">
  <view class="question-type">{{isOpenAnswer ? '💬 开放题' : '📝 选择题'}}</view>
  <view class="question-text">
    <rich-text nodes="{{questionHtml}}"></rich-text>
  </view>

  <!-- 选择题选项 -->
  <view wx:if="{{!isOpenAnswer}}" class="options">
    <block wx:for="{{options}}" wx:key="index">
      <view
        class="option tap-scale {{selectedIndex === index ? 'selected' : ''}}"
        hover-class="tap-scale-hover"
        bindtap="selectOption"
        data-index="{{index}}"
      >
        <text class="option-label">{{item.label}}</text>
        <rich-text class="option-text" nodes="{{item.html}}"></rich-text>
      </view>
    </block>
  </view>

  <!-- 开放题输入 -->
  <view wx:if="{{isOpenAnswer}}" class="open-answer">
    <input
      class="open-input"
      placeholder="请输入你的答案..."
      value="{{openAnswer}}"
      bindinput="bindOpenInput"
    />
    <button class="submit-btn tap-scale" hover-class="tap-scale-hover" bindtap="submitOpenAnswer" disabled="{{!openAnswer.trim()}}">提交</button>
  </view>
</view>