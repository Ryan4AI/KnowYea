/* components/question-card/question-card.wxss */
.question-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 24rpx 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.question-type {
  font-size: 24rpx;
  color: #4CAF50;
  margin-bottom: 16rpx;
}

.question-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.option {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.option.selected {
  background: #e8f5e9;
  border-color: #4CAF50;
}

.option-label {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #e0e0e0;
  color: #666;
  font-size: 24rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.option.selected .option-label {
  background: #4CAF50;
  color: #fff;
}

.option-text {
  font-size: 28rpx;
  color: #333;
}

.open-answer {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.open-input {
  border: 2rpx solid #e0e0e0;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
}

.submit-btn {
  background: #4CAF50;
  color: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
  padding: 20rpx;
}

.submit-btn[disabled] {
  background: #ccc;
}