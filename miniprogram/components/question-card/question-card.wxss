/* components/question-card/question-card.wxss */
.question-card {
  background: #fafbff;
  border-radius: 22rpx;
  padding: 24rpx 22rpx;
  margin: 12rpx 0;
  box-shadow: 0 6rpx 24rpx rgba(26, 29, 46, 0.06);
  border: 1rpx solid rgba(26, 29, 46, 0.06);
  position: relative;
  overflow: hidden;
}

.question-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: linear-gradient(180deg, #6c5ce7, #00c9a7);
  border-radius: 6rpx 0 0 6rpx;
}

.question-type {
  font-size: 22rpx;
  font-weight: 700;
  color: #6c5ce7;
  margin-bottom: 12rpx;
  padding-left: 12rpx;
  letter-spacing: 1rpx;
}

.question-text {
  font-size: 28rpx;
  color: #1a1d2e;
  line-height: 1.65;
  margin-bottom: 20rpx;
  padding-left: 12rpx;
}

.options {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding-left: 8rpx;
}

.option {
  display: flex;
  align-items: center;
  padding: 22rpx 22rpx;
  background: #fff;
  border-radius: 18rpx;
  border: 2rpx solid rgba(26, 29, 46, 0.06);
  box-shadow: 0 2rpx 12rpx rgba(26, 29, 46, 0.04);
}

.option.selected {
  border-color: rgba(108, 92, 231, 0.45);
  background: linear-gradient(135deg, #f5f3ff 0%, #fff 100%);
  box-shadow: 0 6rpx 20rpx rgba(108, 92, 231, 0.12);
}

.option-label {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #eef0f6;
  color: #5c6178;
  font-size: 22rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.option.selected .option-label {
  background: linear-gradient(135deg, #6c5ce7, #a29bfe);
  color: #fff;
}

.option-text {
  font-size: 27rpx;
  color: #2d3254;
  line-height: 1.45;
  flex: 1;
}

.open-answer {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-left: 8rpx;
}

.open-input {
  border: 2rpx solid rgba(26, 29, 46, 0.08);
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  background: #fff;
}

.submit-btn {
  background: linear-gradient(135deg, #6c5ce7 0%, #a29bfe 100%);
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(108, 92, 231, 0.3);
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  opacity: 0.4;
  box-shadow: none;
}
