/* components/achievement-popup/achievement-popup.wxss */

.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(26, 29, 46, 0.55);
  z-index: 2500;
  animation: achMask 0.25s ease both;
}

@keyframes achMask {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.popup-content {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  background: linear-gradient(165deg, #2d3254 0%, #1a1d2e 55%, #252842 100%);
  border-radius: 32rpx;
  padding: 52rpx 40rpx 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 2501;
  box-shadow: 0 24rpx 80rpx rgba(26, 29, 46, 0.45);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  animation: achPop 0.45s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes achPop {
  0% {
    opacity: 0;
    transform: translate(-50%, -46%) scale(0.88);
  }
  100% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
}

.popup-icon {
  font-size: 112rpx;
  margin-bottom: 16rpx;
  animation: achBounce 0.65s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

@keyframes achBounce {
  0% {
    transform: scale(0);
    opacity: 0;
  }
  60% {
    transform: scale(1.08);
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

.popup-title {
  font-size: 26rpx;
  color: rgba(162, 155, 254, 0.95);
  font-weight: 600;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.popup-name {
  font-size: 40rpx;
  color: #fff;
  font-weight: 800;
  margin-bottom: 12rpx;
  text-align: center;
}

.popup-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.65);
  margin-bottom: 40rpx;
  text-align: center;
  line-height: 1.55;
}

.popup-close-btn {
  background: linear-gradient(135deg, var(--capsule-accent) 0%, var(--capsule-accent-2) 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  padding: 22rpx 72rpx;
  border-radius: 999rpx;
  border: none;
  box-shadow: 0 12rpx 36rpx rgba(108, 92, 231, 0.45);
}

.popup-close-btn::after {
  border: none;
}
