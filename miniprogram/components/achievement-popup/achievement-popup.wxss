/* components/achievement-popup/achievement-popup.wxss */

.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
}

.popup-content {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  background: linear-gradient(135deg, #fff9c4 0%, #fff59d 100%);
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 1001;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
}

.popup-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
  animation: bounce 0.6s ease-out;
}

@keyframes bounce {
  0% { transform: scale(0); }
  50% { transform: scale(1.2); }
  100% { transform: scale(1); }
}

.popup-title {
  font-size: 32rpx;
  color: #f57f17;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.popup-name {
  font-size: 40rpx;
  color: #e65100;
  font-weight: bold;
  margin-bottom: 12rpx;
  text-align: center;
}

.popup-desc {
  font-size: 28rpx;
  color: #795548;
  margin-bottom: 40rpx;
  text-align: center;
}

.popup-close-btn {
  background: linear-gradient(135deg, #ffb300 0%, #ff8f00 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  padding: 20rpx 60rpx;
  border-radius: 50rpx;
  border: none;
}