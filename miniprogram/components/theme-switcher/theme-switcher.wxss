.switcher-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(26, 29, 46, 0.48);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  animation: maskIn 0.28s ease both;
}

@keyframes maskIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.switcher-panel {
  width: 100%;
  max-height: 72vh;
  background: linear-gradient(180deg, rgba(108, 92, 231, 0.03) 0%, var(--capsule-surface) 18%);
  border-radius: 36rpx 36rpx 0 0;
  padding: 12rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  box-shadow: 0 -16rpx 64rpx rgba(26, 29, 46, 0.14);
  border-top: 1rpx solid rgba(255, 255, 255, 0.9);
  animation: sheetUp 0.38s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes sheetUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.panel-handle {
  width: 64rpx;
  height: 8rpx;
  background: linear-gradient(90deg, #e4e6ed, #d0d4e0);
  border-radius: 4rpx;
  margin: 0 auto 20rpx;
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.panel-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--capsule-ink);
  letter-spacing: 0.5rpx;
}

.panel-close {
  font-size: 32rpx;
  color: var(--capsule-muted);
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: var(--capsule-bg);
}

.panel-subtitle {
  display: block;
  font-size: 24rpx;
  color: var(--capsule-muted);
  margin-bottom: 22rpx;
}

.theme-scroll {
  max-height: 46vh;
}

.theme-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 24rpx;
  margin-bottom: 16rpx;
  background: var(--capsule-surface);
  border-radius: 24rpx;
  border: 2rpx solid rgba(26, 29, 46, 0.06);
  box-shadow: 0 4rpx 20rpx rgba(26, 29, 46, 0.05);
}

.theme-row.active {
  background: linear-gradient(135deg, rgba(108, 92, 231, 0.05) 0%, #eef9f7 100%);
  border-color: rgba(108, 92, 231, 0.35);
  box-shadow: 0 8rpx 28rpx rgba(108, 92, 231, 0.12);
}

.theme-row-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.theme-emoji {
  font-size: 52rpx;
  margin-right: 20rpx;
  filter: drop-shadow(0 4rpx 8rpx rgba(0, 0, 0, 0.08));
}

.theme-row-info {
  flex: 1;
  min-width: 0;
}

.theme-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--capsule-ink);
}

.theme-desc {
  font-size: 24rpx;
  color: var(--capsule-muted);
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.theme-row-right {
  text-align: right;
  margin-left: 16rpx;
}

.theme-progress {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--capsule-accent);
}

.theme-check {
  font-size: 22rpx;
  color: var(--capsule-accent);
  font-weight: 600;
  margin-top: 6rpx;
}

.empty-themes {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 0;
  color: var(--capsule-muted);
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
  opacity: 0.85;
}

.empty-text {
  font-size: 28rpx;
}

.panel-footer {
  margin-top: 20rpx;
}

.add-theme-btn {
  background: linear-gradient(135deg, var(--capsule-accent) 0%, var(--capsule-accent-2) 100%);
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 24rpx 0;
  box-shadow: 0 12rpx 32rpx rgba(108, 92, 231, 0.35);
}

.add-theme-btn::after {
  border: none;
}
