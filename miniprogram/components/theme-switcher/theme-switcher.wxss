.theme-switcher {
  background: #fff;
  padding: 10rpx 0;
}

.theme-list {
  white-space: nowrap;
  padding: 0 20rpx;
}

.theme-item {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  background: #f0f0f0;
  font-size: 26rpx;
  color: #666;
}

.theme-item.active {
  background: #4CAF50;
  color: #fff;
}