/* components/plant/plant.wxss */

/* Size variants */
.plant-container.size-small {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx;
}

.plant-container.size-small .plant-emoji {
  font-size: 40rpx;
}

.plant-container.size-small .plant-level {
  font-size: 20rpx;
}

.plant-container.size-small .plant-points {
  font-size: 18rpx;
}

.plant-container.size-medium {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
}

.plant-container.size-medium .plant-emoji {
  font-size: 64rpx;
}

.plant-container.size-medium .plant-level {
  font-size: 24rpx;
}

.plant-container.size-medium .plant-points {
  font-size: 22rpx;
}

.plant-container.size-large {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
}

.plant-container.size-large .plant-emoji {
  font-size: 96rpx;
}

.plant-container.size-large .plant-level {
  font-size: 28rpx;
}

.plant-container.size-large .plant-points {
  font-size: 24rpx;
}

/* Plant display */
.plant-container {
  background: linear-gradient(135deg, #f0fff0 0%, #e8f5e9 100%);
  border-radius: 16rpx;
  border: 2rpx solid #a5d6a7;
}

.plant-emoji {
  line-height: 1;
  margin-bottom: 8rpx;
}

.plant-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.plant-level {
  color: #2e7d32;
  font-weight: 500;
}

.plant-points {
  color: #66bb6a;
  margin-top: 4rpx;
}