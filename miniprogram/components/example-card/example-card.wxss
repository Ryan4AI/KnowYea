.example-card {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 16rpx 0;
}

.example-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 12rpx;
}

.example-text {
  font-size: 28rpx;
  color: white;
  line-height: 1.6;
}