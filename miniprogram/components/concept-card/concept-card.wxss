.concept-card {
  background: linear-gradient(135deg, var(--capsule-accent) 0%, var(--capsule-accent-2) 100%);
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 16rpx 0;
}

.concept-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 12rpx;
}

.concept-text {
  font-size: 28rpx;
  color: white;
  line-height: 1.6;
}