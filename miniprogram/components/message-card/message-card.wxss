/* components/message-card/message-card.wxss */
.message-card {
  display: flex;
  margin-bottom: 24rpx;
  padding: 0 32rpx;
}

.message-card.user {
  flex-direction: row-reverse;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #e8f5e9;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.message-card.ai .avatar {
  background: #e3f2fd;
}

.avatar-icon {
  font-size: 36rpx;
}

.content-wrapper {
  max-width: 70%;
  margin: 0 20rpx;
}

.message-content {
  padding: 24rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-word;
}

.message-card.user .message-content {
  background: #4CAF50;
  color: #fff;
  border-bottom-right-radius: 8rpx;
}

.message-card.ai .message-content {
  background: #fff;
  color: #333;
  border-bottom-left-radius: 8rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}

.concept-block {
  background: var(--capsule-bg);
  border-radius: 12rpx;
  padding: 16rpx;
  margin: 8rpx 0;
}

.concept-label {
  margin-right: 8rpx;
}

.time {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.message-card.user .time {
  text-align: right;
}