/* pages/profile/edit/edit.wxss */

.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #eef0fb 0%, #f4f6fc 35%, #f8f9fc 100%);
  padding-bottom: 80rpx;
}

/* 头部 */
.hero-section {
  background: linear-gradient(125deg, #1a1d2e 0%, #252842 50%, #2d3254 100%);
  padding: 80rpx 30rpx 110rpx;
  text-align: center;
}

.hero-emoji {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 10rpx;
}

.hero-desc {
  font-size: 26rpx;
  color: rgba(255,255,255,0.7);
  line-height: 1.6;
  padding: 0 20rpx;
}

/* 表单卡片 */
.form-card {
  margin: -80rpx 20rpx 0;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(26,29,46,0.06);
  border: 1rpx solid rgba(26,29,46,0.05);
}

.form-group { margin-bottom: 36rpx; }

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.hint {
  font-weight: 400;
  color: #bbb;
  font-size: 24rpx;
}

/* picker */
.picker-shell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f5f6fa;
  border: 2rpx solid #e8e8e8;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  font-size: 28rpx;
  color: #bbb;
}

.picker-shell.filled {
  color: #333;
  border-color: #6c5ce7;
  background: #f8f7ff;
}

.arrow { font-size: 32rpx; color: #ccc; }

/* 兴趣分类 */
.cats { margin-bottom: 20rpx; }
.cat-name { font-size: 24rpx; font-weight: 600; color: #555; margin-bottom: 12rpx; }
.cat-tags { display: flex; flex-wrap: wrap; gap: 12rpx; }

.tag {
  display: inline-block;
  padding: 14rpx 24rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
  background: #fafafa;
}

.tag.on {
  border-color: #6c5ce7;
  background: #f0edff;
  color: #6c5ce7;
  font-weight: 600;
}

.tag.rec {
  border-color: #f0a030;
  background: #fff8ed;
  color: #c47a10;
}

.tag.rec.on {
  border-color: #6c5ce7;
  background: #f0edff;
  color: #6c5ce7;
}

/* 自定义标签 */
.custom-area { margin-bottom: 20rpx; }

.custom-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.ctag {
  display: inline-block;
  padding: 12rpx 20rpx;
  border: 2rpx solid #6c5ce7;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #6c5ce7;
  background: #f0edff;
  font-weight: 500;
}

.custom-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.custom-input {
  flex: 1;
  height: 68rpx;
  background: #f5f6fa;
  border: 2rpx solid #e0e0e0;
  border-radius: 16rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
}

.custom-btn {
  flex-shrink: 0;
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 28rpx;
  background: #6c5ce7;
  color: #fff;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
}

/* 保存按钮 */
.save-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #6c5ce7, #a29bfe);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
}

.save-btn[disabled] { opacity: 0.4; }
