<!-- pages/profile/profile.wxml -->
<view class="page-container">
  <!-- 用户信息头部 -->
  <view class="profile-header">
    <view class="avatar">
      <text class="avatar-text">🧑‍🎓</text>
    </view>
    <view class="user-info">
      <view class="user-name">学习者</view>
      <view class="user-slogan">知识胶囊 · 每天几分钟，慢慢变强 📈</view>
    </view>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-grid">
    <view class="stat-card">
      <view class="stat-card-inner">
        <view class="stat-value">{{stats.completedNodes}}</view>
        <view class="stat-label">已完成章节</view>
      </view>
    </view>
    <view class="stat-card">
      <view class="stat-card-inner">
        <view class="stat-value">{{stats.completedThemes}}</view>
        <view class="stat-label">已完成课程</view>
      </view>
    </view>
    <view class="stat-card">
      <view class="stat-card-inner">
        <view class="stat-value">{{stats.totalPoints}}</view>
        <view class="stat-label">总积分</view>
      </view>
    </view>
    <view class="stat-card">
      <view class="stat-card-inner">
        <view class="stat-value">{{stats.streak}}</view>
        <view class="stat-label">连续学习</view>
      </view>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="menu-list">
    <view class="menu-item" bindtap="onNavigateTo" data-page="history">
      <text class="menu-icon">📜</text>
      <text class="menu-text">历史记录</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onNavigateTo" data-page="favorites">
      <text class="menu-icon">❤️</text>
      <text class="menu-text">我的收藏</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onNavigateTo" data-page="achievements">
      <text class="menu-icon">🏆</text>
      <text class="menu-text">成就展示</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onNavigateTo" data-page="garden">
      <text class="menu-icon">🌱</text>
      <text class="menu-text">知识花园</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="menu-list" style="margin-top: 20rpx;">
    <view class="menu-item" bindtap="onNavigateTo" data-page="settings">
      <text class="menu-icon">⚙️</text>
      <text class="menu-text">设置</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- Slogan -->
  <view class="slogan">
    <text>知识胶囊 · 每天几分钟，慢慢变强</text>
  </view>
</view>