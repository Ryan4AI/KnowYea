<!-- pages/profile/profile.wxml — 个人中心 -->
<wxs module="tools">
var contains = function(arr, value) {
  if (!arr || !arr.length) return false;
  for (var i = 0; i < arr.length; i++) {
    if (arr[i] === value) return true;
  }
  return false;
};
module.exports = { contains: contains };
</wxs>
<view class="page">
<view class="page-container">

  <!-- === 表单模式（画像收集/编辑） === -->
  <block wx:if="{{showForm}}">
    <view class="page-header">
      <view class="page-icon">{{isEditing && userProfile ? '✏️' : '👤'}}</view>
      <view class="page-title">{{isEditing && userProfile ? '信息更新' : '先了解一下你'}}</view>
      <view class="page-desc">{{isEditing && userProfile ? '修改你的基本信息' : '让 AI 为你量身定制专属课程'}}</view>
    </view>

    <view class="white-card">
      <!-- 年龄 -->
      <view class="form-group">
        <text class="form-label">年龄</text>
        <picker mode="selector" range="{{ageOptions}}" bindchange="onAgeChange">
          <view class="picker-field {{profileForm.ageIndex >= 0 ? 'active' : ''}}">
            {{ageOptions[profileForm.ageIndex] || '请选择'}}
          </view>
        </picker>
      </view>

      <!-- 职业 -->
      <view class="form-group">
        <text class="form-label">职业</text>
        <picker mode="selector" range="{{occupationOptions}}" bindchange="onOccupationChange">
          <view class="picker-field {{profileForm.occupationIndex >= 0 ? 'active' : ''}}">
            {{occupationOptions[profileForm.occupationIndex] || '请选择'}}
          </view>
        </picker>
      </view>

      <!-- 兴趣标签 -->
      <view class="form-group">
        <text class="form-label">兴趣 <text class="form-hint">（可多选）</text></text>
        <view class="tag-list">
          <view
            wx:for="{{interestOptions}}" wx:key="index"
            class="tag-item {{tools.contains(profileForm.interestIndexes, index) ? 'selected' : ''}}"
            data-index="{{index}}"
            bindtap="onInterestToggle"
          >
            {{item}}
          </view>
        </view>
      </view>

      <!-- 自定义标签列表 -->
      <view class="form-group" wx:if="{{customInterests.length > 0}}">
        <text class="form-label">自定义</text>
        <view class="tag-list">
          <view wx:for="{{customInterests}}" wx:key="index" class="custom-tag" data-index="{{index}}" bindtap="onRemoveCustom">
            {{item}} ✕
          </view>
        </view>
      </view>

      <!-- 添加自定义兴趣 -->
      <view class="form-group">
        <view class="custom-interest-row">
          <input class="custom-interest-input" value="{{_customInputValue}}" placeholder="添加自定义兴趣（最多8字）" bindinput="onCustomInterestInput" bindconfirm="onCustomInterestConfirm" />
          <button class="custom-add-btn" bindtap="onCustomInterestAdd">添加</button>
        </view>
      </view>

      <button class="btn-primary" disabled="{{isSaving}}" bindtap="onSaveProfile">
        {{isSaving ? '保存中...' : isEditing && userProfile ? '✅ 保存修改' : '✅ 开始学习'}}
      </button>
    </view>
  </block>

  <!-- === 展示模式（已有画像） === -->
  <block wx:else>
    <view class="profile-header">
      <view class="avatar"><text class="avatar-text">🧑‍🎓</text></view>
      <view class="user-info">
        <view class="user-name">{{userProfile.ageRange || '学习者'}}</view>
        <view class="user-slogan">{{profileSlogan}}</view>
      </view>
      <view class="header-edit" bindtap="onGoEditProfile"><text>✏️</text></view>
    </view>

    <view class="stats-grid">
      <view class="stat-card"><view class="stat-card-inner">
        <view class="stat-value">{{stats.completedNodes}}</view>
        <view class="stat-label">已完成章节</view>
      </view></view>
      <view class="stat-card"><view class="stat-card-inner">
        <view class="stat-value">{{stats.completedThemes}}</view>
        <view class="stat-label">已完成课程</view>
      </view></view>
      <view class="stat-card"><view class="stat-card-inner">
        <view class="stat-value">{{stats.totalPoints}}</view>
        <view class="stat-label">总积分</view>
      </view></view>
      <view class="stat-card"><view class="stat-card-inner">
        <view class="stat-value">{{stats.streak}}</view>
        <view class="stat-label">连续学习</view>
      </view></view>
    </view>

    <view class="menu-list">
      <view class="menu-item" bindtap="onNavigateTo" data-page="history">
        <text class="menu-icon">📜</text><text class="menu-text">历史记录</text><text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onNavigateTo" data-page="favorites">
        <text class="menu-icon">❤️</text><text class="menu-text">我的收藏</text><text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onNavigateTo" data-page="achievements">
        <text class="menu-icon">🏆</text><text class="menu-text">成就展示</text><text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onNavigateTo" data-page="garden">
        <text class="menu-icon">🌱</text><text class="menu-text">知识花园</text><text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="menu-list" style="margin-top: 20rpx;">
      <view class="menu-item" bindtap="onNavigateTo" data-page="settings">
        <text class="menu-icon">⚙️</text><text class="menu-text">设置</text><text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="slogan"><text>每天几分钟，慢慢变强</text></view>
  </block>

  <!-- 课程生成进度 -->
  <view class="gen-overlay" wx:if="{{genOverlay}}">
    <view class="gen-box">
      <view class="gen-icon">📖</view>
      <view class="gen-stage">{{genStage}}</view>
      <view class="gen-bar-bg">
        <view class="gen-bar-fill" style="width:{{genProgress}}%"></view>
      </view>
    </view>
  </view>

  <!-- 课程确认 -->
  <view class="gen-overlay" wx:elif="{{genResult}}">
    <view class="gen-box gen-confirm-box">
      <view class="gen-icon">✅</view>
      <view class="gen-stage" style="font-weight:600;font-size:36rpx;">{{genResult.name}}</view>
      <view class="gen-confirm-desc">{{genResult.desc}}</view>
      <view class="gen-confirm-lessons">
        <view class="gen-confirm-lesson" wx:for="{{genResult.lessons}}" wx:key="order">
          <text class="gen-confirm-lesson-num">{{'第' + item.order + '节'}}</text>
          <text class="gen-confirm-lesson-title">{{item.title}}</text>
        </view>
      </view>
      <button class="btn-primary" bindtap="onConfirmCourse">开始学习 →</button>
      <button class="btn-secondary" bindtap="onRegenerateCourse">重新生成</button>
    </view>
  </view>
</view>
</view>
