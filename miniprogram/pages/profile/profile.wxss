/* pages/profile/profile.wxss */

.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #eef0fb 0%, #f4f6fc 35%, #f8f9fc 100%);
}

/* 头部 */
.profile-header {
  background: linear-gradient(125deg, #1a1d2e 0%, #252842 50%, #2d3254 100%);
  padding: 50rpx 30rpx 88rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 16rpx 48rpx rgba(26, 29, 46, 0.2);
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: rgba(255,255,255,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
}

.avatar-text {
  font-size: 60rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
}

.user-slogan {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 10rpx;
}

/* 统计网格 */
.stats-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 15rpx;
  margin-top: -50rpx;
}

.stat-card {
  width: 50%;
  padding: 8rpx;
  box-sizing: border-box;
}

.stat-card-inner {
  background: #fff;
  border-radius: 22rpx;
  padding: 28rpx 16rpx;
  text-align: center;
  box-shadow: 0 8rpx 28rpx rgba(26, 29, 46, 0.06);
  border: 1rpx solid rgba(26, 29, 46, 0.05);
}

.stat-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #6c5ce7;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 功能菜单 */
.menu-list {
  background: white;
  border-radius: 22rpx;
  margin: 24rpx 20rpx 0;
  overflow: hidden;
  box-shadow: 0 8rpx 28rpx rgba(26, 29, 46, 0.05);
  border: 1rpx solid rgba(26, 29, 46, 0.05);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.menu-arrow {
  font-size: 32rpx;
  color: #ccc;
}

/* Slogan */
.slogan {
  text-align: center;
  padding: 60rpx 0;
  font-size: 22rpx;
  color: #ccc;
}