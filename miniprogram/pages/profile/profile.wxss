/* pages/profile/profile.wxss */
page {
  background: #0f0f1a;
  min-height: 100vh;
}

.page-container {
  padding-bottom: 40rpx;
}

/* ====== 表单模式 ====== */
.onboard-header {
  text-align: center;
  padding: 80rpx 40rpx 40rpx;
  background: linear-gradient(135deg, #1a1040 0%, #0f0f1a 60%, #0a1628 100%);
}

.onboard-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.onboard-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #f0e6ff;
  margin-bottom: 12rpx;
}

.onboard-desc {
  font-size: 26rpx;
  color: #9a8cb0;
}

.onboard-card {
  margin: -40rpx 24rpx 0;
  background: #1a1a2e;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
}

.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #c0b4d8;
  margin-bottom: 12rpx;
}

.hint {
  font-size: 22rpx;
  color: #7a6e90;
}

.picker-value {
  background: #242038;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #7a6e90;
}

.picker-value.active {
  color: #f0e6ff;
}

.interest-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.interest-tag {
  padding: 14rpx 24rpx;
  background: #242038;
  border: 2rpx solid #242038;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #c0b4d8;
  transition: all 0.2s;
}

.interest-tag.selected {
  background: linear-gradient(135deg, #7c4dff, #5c3dc0);
  border-color: #7c4dff;
  color: #fff;
}

.interest-tag.recommended:not(.selected) {
  border-color: #7c4dff;
  background: rgba(124, 77, 255, 0.1);
}

.custom-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.custom-tag {
  padding: 14rpx 24rpx;
  background: rgba(255, 193, 7, 0.15);
  border: 2rpx solid rgba(255, 193, 7, 0.4);
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #ffc107;
}

.custom-interest-row {
  margin-bottom: 28rpx;
}

.custom-interest-btn {
  display: inline-block;
  padding: 14rpx 24rpx;
  background: rgba(124, 77, 255, 0.1);
  border: 2rpx dashed rgba(124, 77, 255, 0.3);
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #7c4dff;
}

.custom-interest-input {
  background: #242038;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #f0e6ff;
  width: 100%;
  box-sizing: border-box;
}

.save-btn {
  width: 100%;
  padding: 24rpx 0;
  background: linear-gradient(135deg, #7c4dff, #5c3dc0);
  border: none;
  border-radius: 16rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}

/* ====== 展示模式 ====== */
.profile-header {
  display: flex;
  align-items: center;
  padding: 80rpx 32rpx 40rpx;
  background: linear-gradient(135deg, #1a1040 0%, #0f0f1a 60%, #0a1628 100%);
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7c4dff33, #5c3dc033);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.avatar-text { font-size: 48rpx; }

.user-info { flex: 1; }

.user-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #f0e6ff;
  margin-bottom: 8rpx;
}

.user-slogan {
  font-size: 24rpx;
  color: #9a8cb0;
  line-height: 1.4;
}

.header-edit {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 0 24rpx;
  margin-top: -20rpx;
}

.stat-card {
  background: #1a1a2e;
  border-radius: 16rpx;
  padding: 4rpx;
}

.stat-card-inner {
  padding: 24rpx 16rpx;
  text-align: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #7c4dff;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #7a6e90;
}

.menu-list {
  margin: 24rpx 24rpx 0;
  background: #1a1a2e;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #2a2a3e;
}

.menu-item:last-child { border-bottom: none; }

.menu-icon { font-size: 32rpx; margin-right: 20rpx; }

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #c0b4d8;
}

.menu-arrow {
  font-size: 32rpx;
  color: #5a4e70;
}

.slogan {
  text-align: center;
  font-size: 24rpx;
  color: #4a3e60;
  padding: 40rpx 0;
}
