/* pages/profile/profile.wxss */
@import "../../styles/pages.wxss";

/* ====== 自定义标签 ====== */
.custom-tag {
  padding: 12rpx 28rpx;
  background: var(--capsule-accent);
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #fff;
}

.custom-interest-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.custom-interest-input {
  flex: 1;
  background: var(--capsule-bg);
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  height: 60rpx;
  box-sizing: border-box;
}

.custom-add-btn {
  flex-shrink: 0;
  width: 100rpx;
  height: 60rpx;
  line-height: 60rpx;
  background: var(--capsule-accent);
  color: #fff;
  font-size: 24rpx;
  border-radius: 12rpx;
  text-align: center;
  padding: 0;
  border: none;
}

/* 课程生成进度覆盖层 */
.gen-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(255,255,255,0.95);
  display: flex; align-items: center; justify-content: center;
  z-index: 999;
}
.gen-box {
  text-align: center;
  padding: 60rpx 80rpx;
}
.gen-icon { font-size: 80rpx; margin-bottom: 30rpx; }
.gen-stage {
  font-size: 28rpx; color: var(--capsule-ink-secondary); margin-bottom: 30rpx;
  min-height: 40rpx;
}
.gen-bar-bg {
  width: 400rpx; height: 8rpx;
  background: var(--capsule-border); border-radius: 4rpx;
  overflow: hidden;
}
.gen-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--capsule-accent), var(--capsule-accent-2));
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

/* 课程确认覆盖层 */
.gen-confirm-box {
  max-height: 80vh;
  overflow-y: auto;
  padding: 40rpx 60rpx;
}
.gen-confirm-desc {
  font-size: 26rpx;
  color: var(--capsule-muted);
  line-height: 1.6;
  margin-bottom: 24rpx;
  text-align: left;
}
.gen-confirm-lessons {
  text-align: left;
  margin-bottom: 30rpx;
  border-top: 1rpx solid var(--capsule-border);
  padding-top: 16rpx;
}
.gen-confirm-lesson {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--capsule-border);
}
.gen-confirm-lesson-num {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--capsule-accent);
  font-weight: 600;
  width: 80rpx;
}
.gen-confirm-lesson-title {
  font-size: 26rpx;
  color: var(--capsule-ink);
  line-height: 1.4;
}

/* ====== 推荐标签（中性胶囊+可关闭） ====== */
.rec-tag {
  background: var(--capsule-bg);
  border-radius: 30rpx;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: var(--capsule-ink);
  display: inline-flex;
  align-items: center;
}
.rec-tag-close {
  color: var(--capsule-muted);
  font-size: 24rpx;
  margin-left: 6rpx;
}
