/* pages/profile/profile.wxss */
page {
  background: #f5f5f7;
  min-height: 100vh;
}

.page-container {
  padding-bottom: 40rpx;
}

/* ====== 表单模式 — 与 learn 页原引导一致 ====== */
.onboard-header {
  text-align: center;
  padding: 80rpx 40rpx 40rpx;
}

.onboard-icon { font-size: 64rpx; margin-bottom: 16rpx; }

.onboard-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 8rpx;
}

.onboard-desc {
  font-size: 26rpx;
  color: #999;
}

.onboard-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  margin: 0 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #555;
  margin-bottom: 12rpx;
}

.hint {
  font-size: 24rpx;
  color: #aaa;
  font-weight: normal;
}

.picker-value {
  background: #f5f5f7;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
}

.picker-value.active { color: #333; }

.interest-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.interest-tag {
  background: #f5f5f7;
  border-radius: 30rpx;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #666;
}

.interest-tag.selected {
  background: #6366f1;
  color: #fff;
}

.interest-tag.recommended {
  background: #eef2ff;
  border: 2rpx solid #6366f1;
  color: #6366f1;
}

.custom-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.custom-tag {
  padding: 12rpx 28rpx;
  background: #fef9e7;
  border: 2rpx solid #f59e0b;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #f59e0b;
}

.custom-interest-row {
  margin-top: 8rpx;
}

.custom-interest-btn {
  display: inline-block;
  padding: 10rpx 24rpx;
  background: transparent;
  border: 2rpx dashed #ccc;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #999;
}

.custom-interest-input {
  background: #f5f5f7;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  width: 100%;
  box-sizing: border-box;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #6366f1;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  margin-top: 32rpx;
  text-align: center;
}

/* ====== 展示模式 ====== */
.profile-header {
  display: flex;
  align-items: center;
  padding: 80rpx 32rpx 40rpx;
  background: linear-gradient(135deg, #1a1040 0%, #0f0f1a 60%, #0a1628 100%);
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7c4dff33, #5c3dc033);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.avatar-text { font-size: 48rpx; }

.user-info { flex: 1; }

.user-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #f0e6ff;
  margin-bottom: 8rpx;
}

.user-slogan {
  font-size: 24rpx;
  color: #9a8cb0;
  line-height: 1.4;
}

.header-edit {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 0 24rpx;
  margin-top: -20rpx;
}

.stat-card {
  background: #1a1a2e;
  border-radius: 16rpx;
  padding: 4rpx;
}

.stat-card-inner {
  padding: 24rpx 16rpx;
  text-align: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #7c4dff;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #7a6e90;
}

.menu-list {
  margin: 24rpx 24rpx 0;
  background: #1a1a2e;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #2a2a3e;
}

.menu-item:last-child { border-bottom: none; }

.menu-icon { font-size: 32rpx; margin-right: 20rpx; }

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #c0b4d8;
}

.menu-arrow {
  font-size: 32rpx;
  color: #5a4e70;
}

.slogan {
  text-align: center;
  font-size: 24rpx;
  color: #4a3e60;
  padding: 40rpx 0;
}
