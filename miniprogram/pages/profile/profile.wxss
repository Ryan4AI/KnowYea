/* pages/profile/profile.wxss */
@import "../../styles/pages.wxss";

/* ====== 展示模式（已有画像） ====== */
.profile-header {
  display: flex;
  align-items: center;
  padding: 80rpx 32rpx 40rpx;
  background: linear-gradient(135deg, #1a1040 0%, #0f0f1a 60%, #0a1628 100%);
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7c4dff33, #5c3dc033);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.avatar-text { font-size: 48rpx; }

.user-info { flex: 1; }

.user-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #f0e6ff;
  margin-bottom: 8rpx;
}

.user-slogan {
  font-size: 24rpx;
  color: #9a8cb0;
  line-height: 1.4;
}

.header-edit {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 0 24rpx;
  margin-top: -20rpx;
}

.stat-card {
  background: #1a1a2e;
  border-radius: 16rpx;
  padding: 4rpx;
}

.stat-card-inner {
  padding: 24rpx 16rpx;
  text-align: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #7c4dff;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #7a6e90;
}

.menu-list {
  margin: 24rpx 24rpx 0;
  background: #1a1a2e;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #2a2a3e;
}

.menu-item:last-child { border-bottom: none; }

.menu-icon { font-size: 32rpx; margin-right: 20rpx; }

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #c0b4d8;
}

.menu-arrow {
  font-size: 32rpx;
  color: #5a4e70;
}

.slogan {
  text-align: center;
  font-size: 24rpx;
  color: #4a3e60;
  padding: 40rpx 0;
}

/* ====== 表单模式 - 自定义标签 ====== */
.custom-tag {
  padding: 12rpx 28rpx;
  background: #6366f1;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #fff;
}

.custom-interest-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.custom-interest-input {
  flex: 1;
  background: #f5f5f7;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  height: 60rpx;
  box-sizing: border-box;
}

.custom-add-btn {
  flex-shrink: 0;
  width: 100rpx;
  height: 60rpx;
  line-height: 60rpx;
  background: #6366f1;
  color: #fff;
  font-size: 24rpx;
  border-radius: 12rpx;
  text-align: center;
  padding: 0;
  border: none;
}
