/* pages/learn/learn.wxss */

.page-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
}

/* 顶部主题信息 */
.header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.header-left {
  flex: 1;
}

.theme-name {
  font-size: 32rpx;
  font-weight: bold;
}

.theme-progress {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

.node-title {
  font-size: 28rpx;
  margin-top: 8rpx;
  opacity: 0.85;
}

.switch-btn {
  background: rgba(255,255,255,0.2);
  border-radius: 30rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  display: flex;
  align-items: center;
}

.switch-icon {
  margin-right: 8rpx;
}

/* 消息列表 */
.messages-container {
  flex: 1;
  overflow-y: auto;
  padding: 20rpx;
}

.message-list {
  display: flex;
  flex-direction: column;
}

.message-item {
  margin-bottom: 30rpx;
  display: flex;
  flex-direction: column;
}

.message-item.user {
  align-items: flex-end;
}

.message-item.ai {
  align-items: flex-start;
}

.message-content {
  max-width: 85%;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.message-item.user .message-content {
  background-color: #667eea;
  color: white;
  border-bottom-right-radius: 6rpx;
}

.message-item.ai .message-content {
  background-color: #ffffff;
  color: #333;
  border-bottom-left-radius: 6rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

.message-time {
  font-size: 20rpx;
  color: #999;
  margin-top: 8rpx;
}

.message-item.user .message-time {
  margin-right: 10rpx;
}

.message-item.ai .message-time {
  margin-left: 10rpx;
}

/* 消息卡片 */
.concept-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.concept-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.concept-text {
  font-size: 28rpx;
  line-height: 1.6;
}

.example-card {
  background: #f0f7ff;
  border-left: 6rpx solid #667eea;
  border-radius: 12rpx;
  padding: 20rpx;
  margin: 16rpx 0;
}

.example-label {
  font-size: 22rpx;
  color: #667eea;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.example-text {
  font-size: 26rpx;
  color: #444;
  line-height: 1.5;
}

.summary-card {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 16rpx 0;
}

.summary-label {
  font-size: 22rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  opacity: 0.9;
}

.summary-text {
  font-size: 28rpx;
  line-height: 1.6;
}

/* 题目卡片 */
.question-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 16rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.question-label {
  font-size: 22rpx;
  color: #667eea;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.question-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.question-options {
  display: flex;
  flex-direction: column;
}

.option-btn {
  background: #f5f7fa;
  border: 2rpx solid #e8ecf0;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #444;
  text-align: left;
}

.option-btn.selected {
  background: #667eea;
  border-color: #667eea;
  color: white;
}

/* 完成标记 */
.completion-banner {
  background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
  color: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx 0;
  text-align: center;
}

.completion-text {
  font-size: 28rpx;
  font-weight: bold;
}

/* 输入区域 */
.input-container {
  background: white;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.06);
  display: flex;
  align-items: flex-end;
}

.input-wrapper {
  flex: 1;
  display: flex;
  align-items: flex-end;
  background: #f5f7fa;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  min-height: 80rpx;
}

.message-input {
  flex: 1;
  font-size: 28rpx;
  max-height: 200rpx;
  line-height: 1.4;
}

.send-btn {
  background: #667eea;
  color: white;
  border-radius: 36rpx;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  margin-left: 16rpx;
}

.send-btn:active {
  opacity: 0.8;
}

/* 完成按钮 */
.complete-btn-container {
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.complete-btn {
  background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
  color: white;
  border-radius: 44rpx;
  padding: 24rpx;
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
}

.complete-btn::after {
  border: none;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  color: #999;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  text-align: center;
}

.start-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-radius: 40rpx;
  padding: 24rpx 60rpx;
  font-size: 28rpx;
  margin-top: 40rpx;
}

/* loading */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}

.loading-icon {
  font-size: 40rpx;
  animation: rotate 1s linear infinite;
  margin-right: 16rpx;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 植物装饰 */
.plant-decoration {
  position: fixed;
  top: 160rpx;
  right: 30rpx;
  font-size: 60rpx;
  z-index: 10;
  opacity: 0.6;
}