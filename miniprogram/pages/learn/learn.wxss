@import "../../styles/pages.wxss";
/* ===== 自定义导航栏 ===== */
.nav-bar {
  background: #fff;
  flex-shrink: 0;
  border-bottom: 1rpx solid #eee;
}
.nav-bar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 44px;
  padding: 0 20rpx;
}
.nav-left {
  font-size: 36rpx;
  width: 60rpx;
  flex-shrink: 0;
}
.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--capsule-ink);
}
.nav-right {
  width: 60rpx;
  flex-shrink: 0;
}

/* ===== 学习消息区 ===== */
.messages-container {
  flex: 1;
  overflow-y: auto;
  padding: 20rpx 24rpx;
  -webkit-overflow-scrolling: touch;
}
.messages-list { min-height: 100%; }

.message-item {
  margin-bottom: 24rpx;
}

.message-main {
  max-width: 85%;
}
.message-item.user .message-main {
  margin-left: auto;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.message-content {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.message-item.user .message-content {
  background: var(--capsule-accent);
  color: #fff;
}
.message-item.user .message-content .plain-text { color: #fff; }

.plain-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: #333;
  word-break: break-word;
}

/* 概念卡片（统一样式，按类型分色条） */
/* 概念卡片——紧凑式：只有左边色条，无标签文字，适合在 AI 消息流中嵌入 */
.concept-card {
  margin: 8rpx 0;
  border-radius: 8rpx;
  padding: 10rpx 16rpx;
  position: relative;
}
.concept-card-concept { background: #f4f4ff; border-left: 4rpx solid var(--capsule-accent); }
.concept-card-example { background: #f0f9ff; border-left: 4rpx solid #0ea5e9; }
.concept-card-summary { background: #f3fdf6; border-left: 4rpx solid #22c55e; }
.concept-card-eval { background: #fff8ed; border-left: 4rpx solid #f59e0b; }
.concept-content {
  font-size: 28rpx;
  line-height: 1.6;
  color: #333;
}

/* 题目块 */
.question-block {
  margin: 12rpx 0;
  padding: 16rpx 20rpx;
  background: #faf5ff;
  border-radius: 12rpx;
  border: 1rpx solid #e8d5ff;
}
.question-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #7c3aed;
  margin-bottom: 8rpx;
}
.question-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #333;
}
.options-list {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.option-item {
  padding: 14rpx 20rpx;
  background: #fff;
  border: 1rpx solid #e5e7eb;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #374151;
  text-align: center;
}
.option-item:active {
  background: var(--capsule-accent);
  color: #fff;
  border-color: var(--capsule-accent);
}
.open-input-wrap {
  margin-top: 12rpx;
}
.open-input {
  width: 100%;
  padding: 14rpx 16rpx;
  background: #fff;
  border: 1rpx solid #e5e7eb;
  border-radius: 10rpx;
  font-size: 26rpx;
}

/* 评分徽章 */
.score-badge {
  display: inline-flex;
  align-items: center;
  background: linear-gradient(135deg, #f59e0b, #f97316);
  border-radius: 30rpx;
  padding: 8rpx 20rpx;
  margin: 8rpx 0;
}
.score-icon { font-size: 24rpx; margin-right: 6rpx; }
.score-value { font-size: 28rpx; font-weight: 600; color: #fff; }

/* 消息时间 */
.msg-time {
  font-size: 22rpx;
  color: #bbb;
  margin-bottom: 8rpx;
}
.message-item.user .msg-time { text-align: right; }

/* 已完成标记 */
.msg-completed {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #22c55e;
  font-weight: 500;
}

/* 加载动画 */
/* ===== 输入栏 ===== */
.input-bar {
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  flex-shrink: 0;
}
.input-wrapper {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}
.text-input {
  flex: 1;
  max-height: 120rpx;
  background: var(--capsule-bg);
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.5;
}
.send-btn {
  flex-shrink: 0;
  width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: var(--capsule-accent);
  color: #fff;
  font-size: 28rpx;
  border-radius: 16rpx;
  text-align: center;
  border: none;
  padding: 0;
}
.send-btn[disabled] {
  background: #d1d5db;
  color: #999;
}

/* ===== 空状态 ===== */
.welcome {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.welcome-icon { font-size: 100rpx; margin-bottom: 20rpx; }
.welcome-title { font-size: 40rpx; font-weight: 700; color: var(--capsule-ink); }
.welcome-desc { font-size: 28rpx; color: #999; margin-top: 8rpx; }

/* ===== 通用 ===== */
.tap-scale-hover { opacity: 0.7; }
