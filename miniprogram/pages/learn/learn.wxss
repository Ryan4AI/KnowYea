/* pages/learn/learn.wxss — 知识胶囊 · 学习页 */

.page-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #eef0fb 0%, #f4f6fc 28%, #f8f9fc 100%);
}

/* —— 顶栏：深色玻璃感 —— */
.header {
  position: relative;
  background: linear-gradient(125deg, #1a1d2e 0%, #252842 45%, #2d3254 100%);
  color: #fff;
  padding: 24rpx 28rpx 28rpx;
  padding-top: calc(12rpx + env(safe-area-inset-top));
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  box-shadow: 0 12rpx 40rpx rgba(26, 29, 46, 0.18);
}

.header::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.12),
    transparent
  );
}

.header-left {
  flex: 1;
  min-width: 0;
}

.header-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 14rpx;
}

.theme-name {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.theme-progress {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
  margin-top: 10rpx;
}

.node-title {
  font-size: 26rpx;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.88);
  line-height: 1.45;
}

.review-tag {
  display: inline-block;
  margin-top: 14rpx;
  padding: 6rpx 18rpx;
  background: rgba(253, 203, 110, 0.22);
  color: #fdcb6e;
  border-radius: 999rpx;
  font-size: 22rpx;
  border: 1rpx solid rgba(253, 203, 110, 0.35);
}

.switch-btn {
  background: rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(12px);
  border-radius: 999rpx;
  padding: 14rpx 26rpx;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
}

.switch-icon {
  margin-right: 8rpx;
  font-size: 26rpx;
}

/* —— 消息区 —— */
.messages-container {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx 20rpx 16rpx;
  box-sizing: border-box;
}

.message-list {
  display: flex;
  flex-direction: column;
  padding-bottom: 16rpx;
}

.load-more {
  text-align: center;
  padding: 20rpx 28rpx;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #6c5ce7;
  background: rgba(108, 92, 231, 0.08);
  border-radius: 999rpx;
  border: 1rpx solid rgba(108, 92, 231, 0.15);
}

.message-item {
  margin-bottom: 36rpx;
  display: flex;
  flex-direction: column;
  animation: msgIn 0.35s ease-out both;
}

@keyframes msgIn {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.message-item.user {
  align-items: flex-end;
}

.message-item.ai {
  align-items: flex-start;
}

.message-content {
  max-width: 88%;
  padding: 22rpx 26rpx;
  border-radius: 28rpx;
  font-size: 28rpx;
  line-height: 1.65;
  box-sizing: border-box;
}

.message-item.user .message-content {
  background: linear-gradient(135deg, #6c5ce7 0%, #a29bfe 100%);
  color: #fff;
  border-bottom-right-radius: 8rpx;
  box-shadow: 0 8rpx 28rpx rgba(108, 92, 231, 0.35);
}

.message-item.ai .message-content {
  background: #fff;
  color: #1a1d2e;
  border-bottom-left-radius: 8rpx;
  box-shadow: var(--capsule-shadow);
  border: 1rpx solid var(--capsule-border);
}

.message-time {
  font-size: 20rpx;
  color: #9aa0b4;
  margin-top: 10rpx;
}

.message-item.user .message-time {
  margin-right: 8rpx;
}

.message-item.ai .message-time {
  margin-left: 8rpx;
}

.plain-text {
  font-size: 28rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  color: inherit;
}

/* 内嵌卡片（与 AI 气泡内文字协调） */
.concept-card {
  margin: 14rpx 0;
  padding: 24rpx 26rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #f0edff 0%, #e8e4ff 100%);
  border: 1rpx solid rgba(108, 92, 231, 0.15);
  box-shadow: 0 4rpx 20rpx rgba(108, 92, 231, 0.08);
}

.concept-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #6c5ce7;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.concept-text {
  font-size: 28rpx;
  line-height: 1.65;
  color: #2d3254;
}

.example-card {
  margin: 14rpx 0;
  padding: 22rpx 26rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #fffbf5 0%, #fff8ef 100%);
  border-left: 6rpx solid #fdcb6e;
  box-shadow: 0 4rpx 16rpx rgba(253, 203, 110, 0.12);
}

.example-label {
  font-size: 22rpx;
  color: #d68910;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.example-text {
  font-size: 27rpx;
  color: #4a4e5e;
  line-height: 1.6;
}

.summary-card {
  margin: 14rpx 0;
  padding: 24rpx 26rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #e8faf7 0%, #dff6f2 100%);
  border: 1rpx solid rgba(0, 201, 167, 0.2);
  box-shadow: 0 4rpx 20rpx rgba(0, 201, 167, 0.1);
}

.summary-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #00a88a;
  margin-bottom: 10rpx;
}

.summary-text {
  font-size: 28rpx;
  line-height: 1.65;
  color: #2d3254;
}

/* —— 底部操作条 —— */
.action-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.92);
  border-top: 1rpx solid var(--capsule-border);
  backdrop-filter: blur(16px);
}

.favorite-btn {
  font-size: 26rpx;
  color: #5c6178;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: #f4f6fc;
  border: 1rpx solid var(--capsule-border);
}

.complete-btn-inline {
  flex: 1;
  margin-left: 20rpx;
  background: linear-gradient(135deg, #00c9a7 0%, #6c5ce7 100%);
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 22rpx 0;
  box-shadow: 0 8rpx 28rpx rgba(0, 201, 167, 0.35);
}

.complete-btn-inline::after {
  border: none;
}

/* —— 输入区 —— */
.input-container {
  background: rgba(255, 255, 255, 0.96);
  padding: 16rpx 24rpx 20rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--capsule-border);
  box-shadow: 0 -8rpx 40rpx rgba(26, 29, 46, 0.06);
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}

.input-wrapper {
  flex: 1;
  display: flex;
  align-items: flex-end;
  background: #f0f2f8;
  border-radius: 999rpx;
  padding: 14rpx 28rpx;
  min-height: 80rpx;
  border: 1rpx solid var(--capsule-border);
}

.message-input {
  flex: 1;
  font-size: 28rpx;
  max-height: 200rpx;
  line-height: 1.45;
  color: #1a1d2e;
}

.send-btn {
  background: linear-gradient(135deg, #6c5ce7 0%, #a29bfe 100%);
  color: #fff;
  border-radius: 999rpx;
  padding: 18rpx 36rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(108, 92, 231, 0.35);
}

.send-btn::after {
  border: none;
}

.send-btn[disabled] {
  opacity: 0.45;
  box-shadow: none;
}

/* —— 空状态 —— */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 72rpx 40rpx 48rpx;
  margin: 24rpx 16rpx;
  background: #fff;
  border-radius: 32rpx;
  box-shadow: var(--capsule-shadow);
  border: 1rpx solid var(--capsule-border);
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  filter: drop-shadow(0 8rpx 16rpx rgba(108, 92, 231, 0.2));
}

.empty-text {
  font-size: 28rpx;
  text-align: center;
  color: #5c6178;
  line-height: 1.65;
  max-width: 520rpx;
}

.start-btn {
  background: linear-gradient(135deg, #6c5ce7 0%, #a29bfe 100%);
  color: #fff;
  border-radius: 999rpx;
  padding: 22rpx 56rpx;
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 36rpx;
  box-shadow: 0 12rpx 32rpx rgba(108, 92, 231, 0.35);
}

.start-btn::after {
  border: none;
}

.start-btn.secondary {
  background: #fff;
  color: #6c5ce7;
  border: 2rpx solid rgba(108, 92, 231, 0.45);
  box-shadow: none;
  margin-top: 24rpx;
}

/* —— Loading —— */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  color: #9aa0b4;
  font-size: 26rpx;
}

.loading-icon {
  font-size: 40rpx;
  animation: spin 0.9s linear infinite;
  margin-right: 16rpx;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

/* —— 画像弹窗 —— */
.profile-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(26, 29, 46, 0.55);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  animation: fadeIn 0.25s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.profile-panel {
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 32rpx;
  padding: 44rpx 36rpx 40rpx;
  box-sizing: border-box;
  box-shadow: var(--capsule-shadow-lg);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  animation: panelUp 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes panelUp {
  from {
    opacity: 0;
    transform: translateY(40rpx) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.profile-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #1a1d2e;
  text-align: center;
  letter-spacing: 0.5rpx;
}

.profile-subtitle {
  font-size: 26rpx;
  color: #9aa0b4;
  text-align: center;
  margin: 18rpx 0 36rpx;
  line-height: 1.65;
  white-space: pre-wrap;
}

.profile-field {
  margin-bottom: 28rpx;
}

.field-label {
  display: block;
  font-size: 24rpx;
  color: #5c6178;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.field-input,
.field-picker {
  background: #f4f6fc;
  border-radius: 16rpx;
  padding: 22rpx 26rpx;
  font-size: 28rpx;
  color: #1a1d2e;
  border: 1rpx solid var(--capsule-border);
}

.profile-submit {
  margin-top: 20rpx;
  background: linear-gradient(135deg, #6c5ce7 0%, #a29bfe 100%);
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  padding: 26rpx 0;
  box-shadow: 0 12rpx 36rpx rgba(108, 92, 231, 0.4);
}

.profile-submit::after {
  border: none;
}

.interest-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.interest-tag {
  padding: 14rpx 24rpx;
  background: #f4f6fc;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #5c6178;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.interest-tag.selected {
  background: #6c5ce7;
  color: #fff;
  border-color: #6c5ce7;
}

.custom-interest-input {
  margin-top: 20rpx;
  padding: 16rpx 24rpx;
  background: #f4f6fc;
  border-radius: 16rpx;
  font-size: 26rpx;
}

/* 主题预览确认弹窗 */
.theme-preview-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}
.theme-preview-panel {
  width: 600rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  text-align: center;
}
.theme-preview-title {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 20rpx;
}
.theme-preview-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}
.theme-preview-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 20rpx;
}
.theme-preview-info {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 40rpx;
}
.theme-preview-btns {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.btn-start {
  background: #6c5ce7;
  color: #fff;
  font-size: 32rpx;
  padding: 24rpx 0;
  border-radius: 999rpx;
  border: none;
}
.btn-regen {
  background: #f4f6fc;
  color: #6c5ce7;
  font-size: 28rpx;
  padding: 20rpx 0;
  border-radius: 999rpx;
  border: none;
}
.theme-preview-skip {
  font-size: 24rpx;
  color: #aaa;
  margin-top: 32rpx;
  padding: 16rpx;
}

/* 课程生成加载动画 */
.gen-loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
.gen-loading-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 50rpx;
  width: 560rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.gen-loading-icon {
  font-size: 72rpx;
  margin-bottom: 24rpx;
  animation: genPulse 1.5s ease-in-out infinite;
}
@keyframes genPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.15); }
}
.gen-loading-stage {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 32rpx;
  text-align: center;
  min-height: 40rpx;
}
.gen-progress-track {
  width: 100%;
  height: 8rpx;
  background: #f0f0f0;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}
.gen-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #6c5ce7, #a29bfe);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}
.gen-progress-pct {
  font-size: 24rpx;
  color: #999;
  font-family: monospace;
  margin-bottom: 8rpx;
}
.gen-loading-tip {
  font-size: 24rpx;
  color: #aaa;
  text-align: center;
  line-height: 1.6;
}
