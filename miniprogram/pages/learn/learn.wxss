@import "../../styles/pages.wxss";
/* 页面基础 — flex 布局确保输入栏在底部 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow-x: hidden;
}
/* ===== 自定义导航栏 ===== */
.nav-bar {
  background: var(--capsule-surface);
  flex-shrink: 0;
  border-bottom: 1rpx solid var(--capsule-border);
}
.nav-bar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 44px;
  padding: 0 20rpx;
}
.nav-left {
  font-size: 36rpx;
  width: 60rpx;
  flex-shrink: 0;
}
.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--capsule-ink);
}
.nav-right {
  width: 60rpx;
  flex-shrink: 0;
}

/* ===== 学习消息区 ===== */
.messages-container {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}
.messages-list { min-height: 100%; padding: 20rpx 24rpx; }

.message-item {
  margin-bottom: 24rpx;
  overflow-x: hidden;
}
.message-item.user {
  text-align: right;
}
.message-item.ai {
  text-align: left;
}

.msg-time {
  font-size: 22rpx;
  color: var(--capsule-muted);
  margin-bottom: 6rpx;
}
.message-item.user .msg-time {
  text-align: right;
}
.message-item.ai .msg-time {
  text-align: left;
}

.message-main {
}
.message-item.user .message-main {
  max-width: 85%;
  width: fit-content;
  margin-left: auto;
  margin-right: 24rpx;
}
.message-item.ai .message-main {
  max-width: 85%;
  width: fit-content;
  margin-left: 24rpx;
}

.message-content {
  background: var(--capsule-surface);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  box-sizing: border-box;
}
.message-item.user .message-content {
  background: var(--capsule-accent);
  color: #fff;
  text-align: left;
}
.message-item.user .message-content .plain-text { color: #fff; }

.plain-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--capsule-ink);
  word-break: break-word;
}

/* 概念卡片 */
.concept-card {
  margin: 8rpx 0;
  border-radius: 8rpx;
  padding: 10rpx 16rpx;
  position: relative;
}
.concept-card-concept { background: #f4f4ff; border-left: 4rpx solid var(--capsule-accent); }
.concept-card-example { background: #f0f9ff; border-left: 4rpx solid #0ea5e9; }
.concept-card-summary { background: #f3fdf6; border-left: 4rpx solid #22c55e; }
.concept-card-eval { background: #fff8ed; border-left: 4rpx solid #f59e0b; }
.concept-content {
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--capsule-ink);
}

/* 题目块 */
.question-block {
  margin: 12rpx 0;
  padding: 16rpx 20rpx;
  background: var(--capsule-surface);
  border-radius: 12rpx;
  border: 1rpx solid rgba(108, 92, 231, 0.15);
}
.question-label {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--capsule-accent);
  margin-bottom: 8rpx;
}
.question-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--capsule-ink);
}
.options-list {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.option-item {
  padding: 14rpx 20rpx;
  background: var(--capsule-surface);
  border: 1rpx solid var(--capsule-border);
  border-radius: 10rpx;
  font-size: 26rpx;
  color: var(--capsule-ink-secondary);
  text-align: center;
}
.option-item:active {
  background: var(--capsule-accent);
  color: #fff;
  border-color: var(--capsule-accent);
}
/* 评分徽章 */
.score-badge {
  display: inline-flex;
  align-items: center;
  background: linear-gradient(135deg, var(--capsule-warm), #f97316);
  border-radius: 30rpx;
  padding: 8rpx 20rpx;
  margin: 8rpx 0;
}
.score-icon { font-size: 24rpx; margin-right: 6rpx; }
.score-value { font-size: 28rpx; font-weight: 600; color: #fff; }

/* 表格标题 */
.table-caption {
  font-size: 24rpx;
  color: var(--capsule-muted);
  margin-bottom: 8rpx;
  font-weight: 500;
}
.msg-table-wrap {
  margin: 12rpx 0;
  overflow-x: auto;
}
.table-grid {
  display: flex;
  flex-direction: column;
  border: 1rpx solid var(--capsule-border);
  border-radius: 10rpx;
  overflow: hidden;
  font-size: 24rpx;
  background: #fff;
}
.table-header {
  background: var(--capsule-bg);
  font-weight: 600;
}
.table-row {
  display: flex;
}
.table-cell {
  flex: 1;
  padding: 10rpx 14rpx;
  border-bottom: 1rpx solid var(--capsule-border);
  word-break: break-all;
}
.table-row:last-child .table-cell {
  border-bottom: none;
}
.table-header .table-cell {
  border-bottom: 2rpx solid var(--capsule-border);
}

/* 已完成标记 */
.msg-completed {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--capsule-success);
  font-weight: 500;
}

/* AI 打字指示器 */
.typing-bubble {
  min-height: 60rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.typing-indicator {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 4rpx 0;
}

.typing-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--capsule-muted);
  animation: typingBounce 1.4s ease-in-out infinite;
}

.typing-dot:nth-child(1) { animation-delay: 0s; }
.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes typingBounce {
  0%, 80%, 100% {
    transform: scale(0.6);
    opacity: 0.3;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

/* ===== 输入栏 ===== */
.input-bar {
  padding: 16rpx 24rpx;
  background: var(--capsule-surface);
  border-top: 1rpx solid var(--capsule-border);
  flex-shrink: 0;
}
.input-wrapper {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}
.text-input {
  flex: 1;
  max-height: 120rpx;
  background: var(--capsule-bg);
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.5;
}
.send-btn {
  flex-shrink: 0;
  width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: var(--capsule-accent);
  color: #fff;
  font-size: 28rpx;
  border-radius: 16rpx;
  text-align: center;
  border: none;
  padding: 0;
}
.send-btn[disabled] {
  background: var(--capsule-border);
  color: var(--capsule-muted);
}

/* ===== 空状态 ===== */
.welcome {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.welcome-icon { font-size: 100rpx; margin-bottom: 20rpx; }
.welcome-title { font-size: 40rpx; font-weight: 700; color: var(--capsule-ink); }
.welcome-desc { font-size: 28rpx; color: var(--capsule-muted); margin-top: 8rpx; }

/* ===== 通用 ===== */
.tap-scale-hover { opacity: 0.7; }

/* 复习模式提示条 */
.review-banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: linear-gradient(135deg, rgba(100, 200, 255, 0.08), rgba(155, 100, 200, 0.06));
  border: 1px solid rgba(100, 200, 255, 0.2);
  border-radius: 16rpx;
  margin: 16rpx 24rpx;
  padding: 20rpx 24rpx;
}
.review-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}
.review-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.review-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--capsule-ink, #1a1d2e);
}
.review-desc {
  font-size: 24rpx;
  color: var(--capsule-ink-secondary, #5c6178);
}

/* ===== 下一节按钮 ===== */
.next-lesson {
  padding: 20rpx 0;
  text-align: center;
}
.next-btn {
  width: 80%;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--capsule-accent, #6c5ce7);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.next-btn::after { border: none; }

