/* 页面基础 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f7;
}

/* ===== 课程生成进度条 ===== */
.gen-loading-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.gen-loading-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  width: 580rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.15);
}
.gen-icon { font-size: 72rpx; margin-bottom: 20rpx; }
.gen-title { font-size: 32rpx; font-weight: 600; color: #1a1a2e; margin-bottom: 12rpx; }
.gen-stage { font-size: 28rpx; color: #6366f1; margin-bottom: 24rpx; }
.gen-progress-bar {
  width: 100%;
  height: 8rpx;
  background: #e8e8f0;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}
.gen-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #6366f1, #8b5cf6);
  border-radius: 4rpx;
  transition: width 0.5s ease;
}
.gen-hint { font-size: 24rpx; color: #999; }

/* ===== 自定义导航栏 ===== */
.nav-bar {
  background: #fff;
  flex-shrink: 0;
  border-bottom: 1rpx solid #eee;
}
.nav-bar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 44px;
  padding: 0 20rpx;
}
.nav-left {
  font-size: 36rpx;
  width: 60rpx;
  flex-shrink: 0;
}
.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
}
.nav-right {
  width: 60rpx;
  flex-shrink: 0;
}

/* ===== 个人设置 ===== */
.profile-setup {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}
.profile-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  width: 100%;
  max-width: 640rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}
.profile-icon { text-align: center; font-size: 64rpx; margin-bottom: 16rpx; }
.profile-title { text-align: center; font-size: 34rpx; font-weight: 600; color: #1a1a2e; }
.profile-subtitle { text-align: center; font-size: 26rpx; color: #999; margin-bottom: 40rpx; }
.form-group { margin-bottom: 28rpx; }
.form-label { font-size: 28rpx; color: #555; margin-bottom: 12rpx; display: block; }
.picker-value {
  background: #f5f5f7;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
}
.interest-tags { display: flex; flex-wrap: wrap; gap: 12rpx; }
.interest-tag {
  background: #f5f5f7;
  border-radius: 30rpx;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #666;
}
.interest-tag.selected {
  background: #6366f1;
  color: #fff;
}
.interest-tag.recommended {
  background: #eef2ff;
  border: 2rpx solid #6366f1;
  color: #6366f1;
}
.interest-tag.custom {
  background: transparent;
  border: 2rpx dashed #ccc;
  color: #999;
}
.custom-interest-row {
  margin-top: 16rpx;
}
.custom-interest-input {
  background: #f5f5f7;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  width: 100%;
}
.confirm-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #6366f1;
  color: #fff;
  font-size: 32rpx;
  border-radius: 16rpx;
  margin-top: 32rpx;
  text-align: center;
}

/* ===== 主题预览弹窗 ===== */
.theme-preview-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.theme-preview-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  width: 600rpx;
  text-align: center;
}
.preview-icon { font-size: 64rpx; margin-bottom: 16rpx; }
.preview-title { font-size: 34rpx; font-weight: 600; color: #1a1a2e; margin-bottom: 12rpx; }
.preview-desc { font-size: 28rpx; color: #666; margin-bottom: 20rpx; }
.preview-nodes { margin-bottom: 32rpx; }
.preview-nodes-label { font-size: 26rpx; color: #999; }
.preview-actions { display: flex; gap: 20rpx; }
.preview-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border-radius: 16rpx;
  text-align: center;
}
.preview-btn.primary { background: #6366f1; color: #fff; }
.preview-btn.secondary { background: #f5f5f7; color: #666; }

/* ===== 学习消息区 ===== */
.messages-container {
  flex: 1;
  overflow-y: auto;
  padding: 20rpx 24rpx;
  -webkit-overflow-scrolling: touch;
}
.messages-list { min-height: 100%; }

/* 消息气泡 */
.message-item {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
}
.message-item.ai { flex-direction: row; }
.message-item.user { flex-direction: row-reverse; }

.message-avatar {
  width: 60rpx;
  height: 60rpx;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin: 0 12rpx;
}

.message-main {
  max-width: 75%;
}
.message-item.user .message-main {
  align-items: flex-end;
}

.message-content {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.message-item.user .message-content {
  background: #6366f1;
  color: #fff;
}
.message-item.user .message-content .plain-text { color: #fff; }

.plain-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: #333;
  word-break: break-word;
}

/* 卡片样式 */
.concept-card, .example-card, .summary-card, .evaluation-card {
  margin: 12rpx 0;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}
.concept-card { background: #eef2ff; border-left: 6rpx solid #6366f1; }
.example-card { background: #f0f9ff; border-left: 6rpx solid #0ea5e9; }
.summary-card { background: #f0fdf4; border-left: 6rpx solid #22c55e; }
.evaluation-card { background: #fef3e2; border-left: 6rpx solid #f59e0b; }
.card-body { font-size: 28rpx; line-height: 1.6; }

/* 评分徽章 */
.score-badge {
  display: inline-flex;
  align-items: center;
  background: linear-gradient(135deg, #f59e0b, #f97316);
  border-radius: 30rpx;
  padding: 8rpx 20rpx;
  margin: 8rpx 0;
}
.score-icon { font-size: 24rpx; margin-right: 6rpx; }
.score-value { font-size: 28rpx; font-weight: 600; color: #fff; }

/* 消息时间 */
.message-time {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 6rpx;
}
.message-item.user .message-time { text-align: right; }

/* 加载动画 */
.loading-indicator {
  padding: 30rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.typing-dots {
  background: #f0f0ff;
  border-radius: 20rpx;
  padding: 16rpx 28rpx;
  display: flex;
  gap: 8rpx;
}
.dot {
  width: 18rpx;
  height: 18rpx;
  background: #6366f1;
  border-radius: 50%;
  animation: dot-pulse 1.4s ease-in-out infinite;
}

/* 加载中的文字提示 */
.loading-label {
  font-size: 24rpx;
  color: #999;
}
.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes dot-pulse {
  0%, 60%, 100% { opacity: 0.3; transform: scale(0.8); }
  30% { opacity: 1; transform: scale(1); }
}

/* ===== 输入栏 ===== */
.input-bar {
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  flex-shrink: 0;
}
.input-wrapper {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}
.text-input {
  flex: 1;
  max-height: 120rpx;
  background: #f5f5f7;
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.5;
}
.send-btn {
  flex-shrink: 0;
  width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #6366f1;
  color: #fff;
  font-size: 28rpx;
  border-radius: 16rpx;
  text-align: center;
  border: none;
  padding: 0;
}
.send-btn[disabled] {
  background: #d1d5db;
  color: #999;
}

/* ===== 下一节按钮 ===== */
.advance-bar {
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  flex-shrink: 0;
}
.advance-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 16rpx;
  text-align: center;
  letter-spacing: 2rpx;
}
.advance-btn::after {
  border: none;
}

/* 消息卡内嵌的「下一节」按钮 */
.inline-advance {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.inline-advance .advance-btn {
  width: 60%;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
}
.inline-advance-label {
  font-size: 24rpx;
  color: #22c55e;
  font-weight: 500;
}

/* ===== 空状态 ===== */
.welcome {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.welcome-icon { font-size: 100rpx; margin-bottom: 20rpx; }
.welcome-title { font-size: 40rpx; font-weight: 700; color: #1a1a2e; }
.welcome-desc { font-size: 28rpx; color: #999; margin-top: 8rpx; }

/* ===== 通用 ===== */
.tap-scale-hover { opacity: 0.7; }
