/* 页面基础 */
@import "../../styles/gen-loading.wxss";
@import "../../styles/pages.wxss";
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f7;
}

/* ===== 自定义导航栏 ===== */
.nav-bar {
  background: #fff;
  flex-shrink: 0;
  border-bottom: 1rpx solid #eee;
}
.nav-bar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 44px;
  padding: 0 20rpx;
}
.nav-left {
  font-size: 36rpx;
  width: 60rpx;
  flex-shrink: 0;
}
.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
}
.nav-right {
  width: 60rpx;
  flex-shrink: 0;
}

/* ===== 学习消息区 ===== */
.messages-container {
  flex: 1;
  overflow-y: auto;
  padding: 20rpx 24rpx;
  -webkit-overflow-scrolling: touch;
}
.messages-list { min-height: 100%; }

.message-item {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
}
.message-item.ai { flex-direction: row; }
.message-item.user { flex-direction: row-reverse; }

.message-avatar {
  width: 60rpx;
  height: 60rpx;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin: 0 12rpx;
}

.message-main {
  max-width: 75%;
}
.message-item.user .message-main {
  align-items: flex-end;
}

.message-content {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.message-item.user .message-content {
  background: #6366f1;
  color: #fff;
}
.message-item.user .message-content .plain-text { color: #fff; }

.plain-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: #333;
  word-break: break-word;
}

/* 卡片样式 */
.concept-card, .example-card, .summary-card, .evaluation-card {
  margin: 12rpx 0;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}
.concept-card { background: #eef2ff; border-left: 6rpx solid #6366f1; }
.example-card { background: #f0f9ff; border-left: 6rpx solid #0ea5e9; }
.summary-card { background: #f0fdf4; border-left: 6rpx solid #22c55e; }
.evaluation-card { background: #fef3e2; border-left: 6rpx solid #f59e0b; }
.card-body { font-size: 28rpx; line-height: 1.6; }

/* 评分徽章 */
.score-badge {
  display: inline-flex;
  align-items: center;
  background: linear-gradient(135deg, #f59e0b, #f97316);
  border-radius: 30rpx;
  padding: 8rpx 20rpx;
  margin: 8rpx 0;
}
.score-icon { font-size: 24rpx; margin-right: 6rpx; }
.score-value { font-size: 28rpx; font-weight: 600; color: #fff; }

/* 消息时间 */
.message-time {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 6rpx;
}
.message-item.user .message-time { text-align: right; }

/* 加载动画 */
.loading-indicator {
  padding: 30rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.typing-dots {
  background: #f0f0ff;
  border-radius: 20rpx;
  padding: 16rpx 28rpx;
  display: flex;
  gap: 8rpx;
}
.dot {
  width: 18rpx;
  height: 18rpx;
  background: #6366f1;
  border-radius: 50%;
  animation: dot-pulse 1.4s ease-in-out infinite;
}
.loading-label {
  font-size: 24rpx;
  color: #999;
}
.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes dot-pulse {
  0%, 60%, 100% { opacity: 0.3; transform: scale(0.8); }
  30% { opacity: 1; transform: scale(1); }
}

/* ===== 输入栏 ===== */
.input-bar {
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  flex-shrink: 0;
}
.input-wrapper {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}
.text-input {
  flex: 1;
  max-height: 120rpx;
  background: #f5f5f7;
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.5;
}
.send-btn {
  flex-shrink: 0;
  width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #6366f1;
  color: #fff;
  font-size: 28rpx;
  border-radius: 16rpx;
  text-align: center;
  border: none;
  padding: 0;
}
.send-btn[disabled] {
  background: #d1d5db;
  color: #999;
}

/* ===== 下一节按钮（消息卡内嵌） ===== */
.inline-advance {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.advance-btn {
  width: 60%;
  height: 72rpx;
  line-height: 72rpx;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 16rpx;
  text-align: center;
  letter-spacing: 2rpx;
}
.advance-btn::after { border: none; }
.inline-advance-label {
  font-size: 24rpx;
  color: #22c55e;
  font-weight: 500;
}

/* ===== 空状态 ===== */
.welcome {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.welcome-icon { font-size: 100rpx; margin-bottom: 20rpx; }
.welcome-title { font-size: 40rpx; font-weight: 700; color: #1a1a2e; }
.welcome-desc { font-size: 28rpx; color: #999; margin-top: 8rpx; }

/* ===== 课程生成器（内嵌） ===== */
.gen-page {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}
.gen-page .page-container {
  padding: 0 32rpx 40rpx;
  max-width: 700rpx;
  margin: auto auto; /* center vertically because flex */
}
.gen-input-row {
  display: flex;
  gap: 16rpx;
}
.gen-input {
  flex: 1;
  background: #f5f5f7;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  height: 72rpx;
  box-sizing: border-box;
}
.gen-btn {
  flex-shrink: 0;
  height: 72rpx;
  line-height: 72rpx;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 16rpx;
  padding: 0 24rpx;
  text-align: center;
  border: none;
}
.gen-btn[disabled] {
  background: #d1d5db;
  color: #999;
}
.gen-examples { margin-top: 8rpx; }
.gen-examples-label { font-size: 24rpx; color: #bbb; margin-bottom: 12rpx; display: block; }
.gen-tags { display: flex; flex-wrap: wrap; gap: 12rpx; }
.gen-tag {
  background: #f5f5f7;
  border-radius: 30rpx;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: #666;
}

/* ===== 通用 ===== */
.tap-scale-hover { opacity: 0.7; }
