<wxs module="tools">
var contains = function(arr, value) {
  if (!arr || !arr.length) return false;
  for (var i = 0; i < arr.length; i++) {
    if (arr[i] === value) return true;
  }
  return false;
};
module.exports = { contains: contains };
</wxs>

<view class="page">

  <!-- 等待登录：全屏加载 -->
  <view class="loading-screen" wx:if="{{showSplash}}">
    <view class="loading-icon">🌱</view>
    <text class="loading-text">小知也</text>
  </view>
  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="padding-top: {{navBarTop}}px">
    <view class="nav-bar-inner">
      <text class="nav-left" wx:if="{{course}}" bindtap="onGardenTap">🌱</text>
      <text class="nav-left" wx:else></text>
      <text class="nav-title">{{course ? course.name : '小知也'}}</text>
      <text class="nav-right" wx:if="{{!course}}"></text>
    </view>
  </view>

  <!-- 学习区域 -->
  <scroll-view class="messages-container" scroll-y="{{true}}" scroll-with-animation="{{true}}" upper-threshold="50" scroll-into-view="{{scrollIntoView}}" wx:if="{{course}}">
    <view class="messages-list" id="msg-list">
      <block wx:for="{{messages}}" wx:key="id">
        <view class="message-item {{item.role}}" id="msg-{{index}}">
            <view class="message-main">
              <view class="msg-time {{item.role}}">{{item.timeStr}}</view>
              <view class="message-content {{item.role}}">

              <!-- 消息块 -->
              <block wx:for="{{item.blocks}}" wx:for-item="block" wx:key="type">
                <!-- 纯文本（支持 markdown 渲染） -->
                <rich-text wx:if="{{block.type === 'text'}}" class="msg-text" nodes="{{block.html}}"></rich-text>

                <!-- 概念卡片（概念/例子/总结/评价 → 紧凑的左边框标记，不显示标签文字） -->
                <view wx:elif="{{block.type === '概念' || block.type === '例子' || block.type === '总结' || block.type === '评价'}}" class="concept-card concept-card-{{block.type == '概念' ? 'concept' : block.type == '例子' ? 'example' : block.type == '总结' ? 'summary' : 'eval'}}">
                  <rich-text class="concept-content" nodes="{{block.html}}"></rich-text>
                </view>

                <!-- 选择题 -->
                <view wx:elif="{{block.type === 'choice'}}" class="question-block">
                  <view class="question-label">❓ 选择题</view>
                  <rich-text nodes="{{block.html}}" class="question-text"></rich-text>
                  <view class="options-list">
                    <text class="option-item" wx:for="{{block.options}}" wx:key="index" data-value="{{item}}" data-msgid="{{block._msgId}}" bindtap="onOptionTap">{{item}}</text>
                  </view>
                </view>

                <!-- 问答题（用聊天框输入，不需要独立输入框） -->
                <view wx:elif="{{block.type === 'open'}}" class="question-block">
                  <view class="question-label">✏️ 问答题</view>
                  <rich-text nodes="{{block.html}}" class="question-text"></rich-text>
                </view>

                <!-- 评分 -->
                <view wx:elif="{{block.type === '评分'}}" class="score-badge">
                  <text>⭐ {{block.score}}/10</text>
                </view>

                <!-- 表格 -->
                <view wx:elif="{{block.type === 'table'}}" class="msg-table-wrap">
                  <view class="table-caption">📊 表格</view>
                  <view class="table-grid">
                    <view class="table-row table-header">
                      <view class="table-cell" wx:for="{{block.headers}}" wx:key="index">{{item}}</view>
                    </view>
                    <view class="table-row" wx:for="{{block.rows}}" wx:for-item="row" wx:key="index">
                      <view class="table-cell" wx:for="{{row}}" wx:for-index="ci" wx:key="ci">{{item}}</view>
                    </view>
                  </view>
                </view>
              </block>

              <!-- 完成标记 -->
              <view class="msg-completed" wx:if="{{item.completed}}">
                <text>✅ 已完成</text>
              </view>
            </view>
          </view>
        </view>
      </block>

      <!-- AI 打字指示器 -->
      <view class="message-item ai" wx:if="{{isLoading}}">
        <view class="message-main">
          <view class="message-content ai typing-bubble">
            <view class="typing-indicator">
              <view class="typing-dot"></view>
              <view class="typing-dot"></view>
              <view class="typing-dot"></view>
            </view>
          </view>
        </view>
      </view>

      <!-- "下一节"按钮 -->
      <view class="next-lesson" wx:if="{{isCompleted && hasNextLesson && !isPendingTransition}}">
        <button class="next-btn" bindtap="manualAdvance">
          <text>继续下一节 →</text>
        </button>
      </view>

      <!-- 完成全部课程 -->
      <view class="next-lesson" wx:if="{{isCompleted && !hasNextLesson && !isPendingTransition}}">
        <button class="next-btn" bindtap="onFinishCourse">
          <text>🎉 完成课程，更多学习</text>
        </button>
      </view>

      <view id="msg-bottom"></view>
    </view>
  </scroll-view>

  <!-- 输入栏 -->
  <view class="input-bar" wx:if="{{course}}">
    <view class="input-wrapper">
      <textarea
        class="text-input"
        model:value="{{inputValue}}"
        placeholder="输入你的想法..."
        bindinput="onInputChange"
        auto-height="{{true}}"
        maxlength="-1"
      ></textarea>
      <button class="send-btn tap-scale" hover-class="tap-scale-hover" bindtap="doSend">
        <text>发送</text>
      </button>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="welcome" wx:if="{{!course && !isLoading}}">
    <view class="welcome-icon">📚</view>
    <view class="welcome-title">小知也</view>
    <view class="welcome-desc">碎片时间，系统学习</view>
  </view>

  <!-- 加载中 toast 处理，无需额外 UI -->
</view>
