<wxs module="tools">
var contains = function(arr, value) {
  if (!arr || !arr.length) return false;
  for (var i = 0; i < arr.length; i++) {
    if (arr[i] === value) return true;
  }
  return false;
};
module.exports = { contains: contains };
</wxs>
<!-- 课程生成进度覆盖层 -->
<view class="gen-loading-mask" wx:if="{{showGenLoading}}">
  <view class="gen-loading-card">
    <view class="gen-icon">🧠</view>
    <view class="gen-title">AI 正在为你定制专属课程</view>
    <view class="gen-stage">{{genStageText}}</view>
    <view class="gen-progress-bar">
      <view class="gen-progress-fill" style="width:{{genProgress}}%"></view>
    </view>
    <view class="gen-hint">根据你的兴趣和职业量身打造，请稍候</view>
  </view>
</view>

<view class="page">
  <!-- 自定义导航栏 -->
  <view class="nav-bar" wx:if="{{!showProfileSetup}}" style="padding-top: {{navBarTop}}px">
    <view class="nav-bar-inner">
      <text class="nav-left" wx:if="{{theme}}" bindtap="onGardenTap">🌱</text>
      <text class="nav-left" wx:else></text>
      <text class="nav-title">{{theme.name || '小知也'}}</text>
      <text class="nav-right"></text>
    </view>
  </view>

  <!-- 个人信息设置 -->
  <view class="profile-setup" wx:if="{{showProfileSetup}}">
    <view class="profile-card">
      <view class="profile-icon">👤</view>
      <view class="profile-title">先了解一下你</view>
      <view class="profile-subtitle">让AI为你量身定制专属课程</view>

      <!-- 年龄 -->
      <view class="form-group">
        <text class="form-label">年龄</text>
        <picker mode="selector" range="{{ageOptions}}" bindchange="onAgeChange">
          <view class="picker-value">{{ageOptions[profileForm.ageIndex] || '请选择'}}</view>
        </picker>
      </view>

      <!-- 职业 -->
      <view class="form-group">
        <text class="form-label">职业</text>
        <picker mode="selector" range="{{occupationOptions}}" bindchange="onOccupationChange">
          <view class="picker-value">{{occupationOptions[profileForm.occupationIndex] || '请选择'}}</view>
        </picker>
      </view>

      <!-- 兴趣 -->
      <view class="form-group">
        <text class="form-label">兴趣（可多选）</text>
        <view class="interest-tags">
          <view
            wx:for="{{interestOptions}}"
            wx:key="index"
            class="interest-tag {{tools.contains(profileForm.interestIndexes, index) ? 'selected' : ''}}"
            data-index="{{index}}"
            bindtap="onInterestToggle"
          >{{item}}</view>
          <view
            wx:if="{{!showCustomInterestInput}}"
            class="interest-tag custom"
            bindtap="onShowCustomInterest"
          >✏️ 自定义</view>
        </view>
        <view wx:if="{{showCustomInterestInput}}" class="custom-interest-row">
          <input class="custom-interest-input" placeholder="输入兴趣，回车添加" bindconfirm="onCustomInterestConfirm" bindblur="onCustomInterestBlur" />
        </view>
      </view>

      <button class="confirm-btn tap-scale" hover-class="tap-scale-hover" bindtap="onSubmitProfile">
        开始学习
      </button>
    </view>
  </view>

  <!-- 主题预览弹窗 -->
  <view class="theme-preview-mask" wx:if="{{pendingTheme}}">
    <view class="theme-preview-card">
      <view class="preview-icon">📖</view>
      <view class="preview-title">{{pendingTheme.name}}</view>
      <view class="preview-desc">{{pendingTheme.description}}</view>
      <view class="preview-nodes">
        <text class="preview-nodes-label">共 {{pendingTheme.totalNodes}} 个课时</text>
      </view>
      <view class="preview-actions">
        <button class="preview-btn secondary" bindtap="onRegenerateTheme">重新生成</button>
        <button class="preview-btn primary" bindtap="onConfirmTheme">开始学习</button>
      </view>
    </view>
  </view>

  <!-- 学习区域 -->
  <scroll-view class="messages-container" scroll-y="{{true}}" scroll-with-animation="{{true}}" upper-threshold="50" scroll-into-view="msg-bottom" wx:if="{{!showProfileSetup && theme}}">
    <view class="messages-list" id="msg-list">
      <block wx:for="{{messages}}" wx:key="id">
        <view class="message-item {{item.role}}" id="msg-{{index}}">
          <view class="message-avatar">{{item.role === 'ai' ? '🧑‍🏫' : '👤'}}</view>
          <view class="message-main">
            <view class="message-content">
              <block wx:for="{{item.blocks}}" wx:for-item="block" wx:key="index">
                <view wx:if="{{block.type === 'text'}}" class="plain-text"><rich-text nodes="{{block.html}}"></rich-text></view>
                <view wx:elif="{{block.type === '概念'}}" class="concept-card">
                  <view class="card-body"><rich-text nodes="{{block.html || block.text}}"></rich-text></view>
                </view>
                <view wx:elif="{{block.type === '例子'}}" class="example-card">
                  <view class="card-body"><rich-text nodes="{{block.html || block.text}}"></rich-text></view>
                </view>
                <view wx:elif="{{block.type === '总结'}}" class="summary-card">
                  <view class="card-body"><rich-text nodes="{{block.html || block.text}}"></rich-text></view>
                </view>
                <view wx:elif="{{block.type === '评价'}}" class="evaluation-card">
                  <view class="card-body"><rich-text nodes="{{block.html || block.text}}"></rich-text></view>
                </view>
                <view wx:elif="{{block.type === '评分'}}" class="score-badge">
                  <text class="score-icon">⭐</text>
                  <text class="score-value">{{block.score}}/10</text>
                </view>
                <question-card
                  wx:elif="{{block.type === 'choice' || block.type === 'open'}}"
                  question="{{block}}"
                  bind:select="onQuestionSelect"
                  bind:submit="onQuestionSubmit"
                />
              </block>
            </view>
            <!-- 最后一条 AI 消息完成时的「下一节」按钮 -->
            <view wx:if="{{item.completed && hasNextNode && index === messages.length - 1}}" class="inline-advance">
              <view class="inline-advance-label">✅ 本节已学完</view>
              <button class="advance-btn" bindtap="manualAdvance">下一节 →</button>
            </view>
            <view wx:if="{{item.blocks.length > 0}}" class="message-time">{{item.timeStr}}</view>
          </view>
        </view>
      </block>
      <view id="msg-bottom"></view>
    </view>

    <!-- 加载指示器 -->
    <view class="loading-indicator" wx:if="{{isLoading}}">
      <view class="typing-dots">
        <view class="dot"></view>
        <view class="dot"></view>
        <view class="dot"></view>
      </view>
      <text class="loading-label">AI 生成中…</text>
    </view>
  </scroll-view>

  <!-- 输入栏（始终显示，不随完成状态隐藏） -->
  <view class="input-bar" wx:if="{{theme}}">
    <view class="input-wrapper">
      <textarea
        class="text-input"
        value="{{inputValue}}"
        placeholder="输入你的想法..."
        bindinput="onInputChange"
        auto-height="{{true}}"
        maxlength="-1"
      ></textarea>
      <button class="send-btn tap-scale" hover-class="tap-scale-hover" bindtap="doSend" disabled="{{!canSend}}">
        <text>发送</text>
      </button>
    </view>
  </view>

  <!-- 空状态 - 欢迎页 -->
  <view class="welcome" wx:if="{{!showProfileSetup && !theme && !pendingTheme}}">
    <view class="welcome-icon">📚</view>
    <view class="welcome-title">小知也</view>
    <view class="welcome-desc">碎片时间，系统学习</view>
  </view>
</view>
