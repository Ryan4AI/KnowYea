<view class="page">
  <!-- 加载状态 -->
  <view class="loading" wx:if="{{isLoading}}">
    <text class="loading-icon">🌱</text>
    <text class="loading-text">加载中...</text>
  </view>

  <scroll-view class="scroll" scroll-y="{{true}}" wx:else>
    <!-- ===== 花园头部 ===== -->
    <view class="garden-header">
      <view class="header-plant-wrap">
        <view class="header-plant">{{plant.emoji}}</view>
        <view class="header-level">「{{plant.title}}」</view>
        <view class="header-name">Lv.{{plant.level}} {{plant.name}}</view>
      </view>
      <view class="header-welcome">
        <text class="header-greeting">🌿 你的知识花园</text>
        <text class="header-stats">已学习 {{stats.completedNodes}} 个课时 · {{stats.completedThemes}} 门课程</text>
      </view>
      <!-- 下一等级进度 -->
      <view class="next-level-wrap" wx:if="{{plant.nextThreshold}}">
        <view class="next-level-bar">
          <view class="next-level-fill" style="width:{{(stats.completedNodes / plant.nextThreshold) * 100}}%"></view>
        </view>
        <text class="next-level-text">还需 {{plant.nextThreshold - stats.completedNodes}} 课时 → {{plant.nextName}}</text>
      </view>
      <view class="header-points">{{plantPoints}} 积分</view>
    </view>

    <!-- ===== 连续学习 ===== -->
    <view class="streak-bar" wx:if="{{stats.streak > 0}}">
      <text class="streak-icon">🔥</text>
      <text class="streak-text">{{stats.streak}} 天 · {{streakText}}</text>
    </view>

    <!-- ===== 本周学习日历 ===== -->
    <view class="timeline-section" wx:if="{{timelineDays.length > 0}}">
      <view class="timeline-header">
        <text class="timeline-title">📅 本周学习</text>
        <text class="timeline-total">{{timelineTotal}} 课时</text>
      </view>
      <view class="timeline-grid">
        <view
          class="timeline-cell {{day.count > 0 ? 'active' : 'empty'}}"
          wx:for="{{timelineDays}}"
          wx:key="date"
        >
          <view class="cell-weekday">{{day.weekday}}</view>
          <view class="cell-bar {{'level-' + (day.count > 0 ? Math.min(day.count, 5) : 0)}}"></view>
          <view class="cell-count">{{day.count || ''}}</view>
        </view>
      </view>
    </view>

    <!-- ===== 用户统计 ===== -->
    <view class="stats-grid">
      <view class="stat-card">
        <view class="stat-card-inner">
          <view class="stat-value">{{stats.completedNodes}}</view>
          <view class="stat-label">已学课时</view>
        </view>
      </view>
      <view class="stat-card">
        <view class="stat-card-inner">
          <view class="stat-value">{{stats.completedThemes}}</view>
          <view class="stat-label">完成课程</view>
        </view>
      </view>
      <view class="stat-card">
        <view class="stat-card-inner">
          <view class="stat-value">{{stats.totalPoints}}</view>
          <view class="stat-label">总积分</view>
        </view>
      </view>
      <view class="stat-card">
        <view class="stat-card-inner">
          <view class="stat-value">{{stats.streak}}</view>
          <view class="stat-label">连续天数</view>
        </view>
      </view>
    </view>

    <!-- ===== 我的课程 ===== -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">📖 我的课程</text>
      </view>

      <view class="empty-state" wx:if="{{themes.length === 0}}">
        <text class="empty-intro">🌿 你还没有课程</text>
        <text class="empty-sub">告诉我你想学什么，AI 会为你量身定制课程</text>
        <view class="new-theme-card" bindtap="onNewTheme">✨ 让 AI 生成第一门课</view>
      </view>

      <view class="theme-list" wx:else>
        <!-- 生成新课卡片 -->
        <view class="new-theme-card" bindtap="onNewTheme">✨ 生成新课程</view>
        <view class="theme-item" wx:for="{{themes}}" wx:key="_id">
          <view class="theme-top">
            <view class="theme-emoji">📖</view>
            <view class="theme-info">
              <view class="theme-name">{{item.name}}</view>
              <view class="theme-desc">{{item.description}}</view>
            </view>
          </view>

          <view class="theme-progress">
            <view class="progress-bar">
              <view class="progress-fill" style="width:{{item.progressPercent || 0}}%"></view>
            </view>
            <text class="progress-text">{{item.completedCount || 0}}/{{item.totalNodes}}</text>
          </view>

          <view class="theme-last-node" wx:if="{{item.currentNodeOrder > 1}}">
            <text>上次学到：第 {{item.currentNodeOrder - 1}} 课时</text>
          </view>

          <view class="theme-actions">
            <button class="btn primary" bindtap="onContinue" data-theme-id="{{item._id}}">
              {{item.status === 'completed' ? '重新学习' : '继续学习'}}
            </button>
            <button class="btn secondary" bindtap="onReview" data-theme-id="{{item._id}}">复习</button>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 功能菜单 ===== -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">⚡ 更多</text>
      </view>

      <view class="menu-list">
        <view class="menu-item" bindtap="onEditProfile">
          <text class="menu-icon">👤</text>
          <text class="menu-text">个人画像</text>
          <text class="menu-arrow">›</text>
        </view>
        <view class="menu-item" bindtap="onNavigateTo" data-page="history">
          <text class="menu-icon">📜</text>
          <text class="menu-text">学习记录</text>
          <text class="menu-badge" wx:if="{{recentHistory.length > 0}}">{{recentHistory.length}}+</text>
          <text class="menu-arrow">›</text>
        </view>
        <view class="menu-item" bindtap="onNavigateTo" data-page="favorites">
          <text class="menu-icon">❤️</text>
          <text class="menu-text">我的收藏</text>
          <text class="menu-badge" wx:if="{{favoriteCount > 0}}">{{favoriteCount}}</text>
          <text class="menu-arrow">›</text>
        </view>
        <view class="menu-item" bindtap="onNavigateTo" data-page="achievements">
          <text class="menu-icon">🏆</text>
          <text class="menu-text">成就</text>
          <text class="menu-badge" wx:if="{{unlockedAchievements > 0}}">{{unlockedAchievements}}</text>
          <text class="menu-arrow">›</text>
        </view>
        <view class="menu-item" bindtap="onNavigateTo" data-page="settings">
          <text class="menu-icon">⚙️</text>
          <text class="menu-text">设置</text>
          <text class="menu-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 底部留白 -->
    <view class="footer">知识胶囊 · 每天几分钟，慢慢变强</view>
  </scroll-view>
</view>
