.page-container { min-height: 100vh; background: #f5f5f5; padding: 20rpx; }
.loading { display: flex; align-items: center; justify-content: center; padding: 100rpx; color: #999; }
.loading-icon { font-size: 40rpx; margin-right: 16rpx; animation: rotate 1s linear infinite; }
@keyframes rotate { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
.empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 120rpx 40rpx; }
.empty-icon { font-size: 100rpx; margin-bottom: 30rpx; }
.empty-text { font-size: 28rpx; color: #999; text-align: center; }
.garden-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.garden-item { width: 48%; background: white; border-radius: 16rpx; padding: 30rpx; margin-bottom: 20rpx; text-align: center; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.plant-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.plant-name { font-size: 26rpx; font-weight: bold; color: #333; }
.plant-level { font-size: 24rpx; color: #667eea; margin-top: 8rpx; }
.plant-points { font-size: 22rpx; color: #999; margin-top: 6rpx; }
.plant-decorations { font-size: 22rpx; color: #ff9800; margin-top: 8rpx; }
