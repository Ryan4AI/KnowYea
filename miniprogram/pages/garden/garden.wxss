/* 页面基础 */
.page { height: 100vh; background: var(--capsule-bg); display: flex; flex-direction: column; }
.scroll { flex: 1; }

/* 加载 */
.loading {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 200rpx 0;
}
.loading-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.loading-text { font-size: 28rpx; color: var(--capsule-muted); }

/* 花园头部 */
.garden-header {
  background: linear-gradient(135deg, var(--capsule-ink), #16213e);
  display: flex; flex-direction: column; align-items: center;
  padding: 60rpx 0 24rpx;
}
.header-plant-wrap {
  display: flex; flex-direction: column; align-items: center;
  margin-bottom: 8rpx;
}
.header-plant { font-size: 80rpx; }
.header-level { font-size: 36rpx; color: var(--capsule-accent-2); font-weight: 600; }
.header-name { font-size: 22rpx; color: rgba(162,155,254,0.5); margin-top: 2rpx; }
.header-stats-line {
  display: flex; align-items: center; gap: 12rpx;
  margin-top: 4rpx;
}
.header-stats { font-size: 24rpx; color: var(--capsule-muted); }
.header-level-tag { font-size: 22rpx; color: var(--capsule-accent); background: rgba(108,92,231,0.15); padding: 2rpx 14rpx; border-radius: 20rpx; }

/* 下一等级进度 */
.next-level-wrap {
  width: 60%; margin: 12rpx auto 0; text-align: center;
}
.next-level-bar {
  height: 6rpx; background: rgba(255,255,255,0.15); border-radius: 3rpx; overflow: hidden;
}
.next-level-fill {
  height: 100%; background: linear-gradient(90deg, var(--capsule-accent), var(--capsule-accent-2));
  border-radius: 3rpx; transition: width 0.5s;
}
.next-level-text { font-size: 20rpx; color: rgba(255,255,255,0.35); margin-top: 6rpx; display: block; }

/* 连续学习 */
.streak-bar {
  display: flex; align-items: center; justify-content: center;
  margin: -10rpx 24rpx 0; padding: 16rpx; background: rgba(253, 203, 110, 0.12);
  border-radius: 16rpx; position: relative; z-index: 1;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.streak-icon { font-size: 32rpx; margin-right: 10rpx; }
.streak-text { font-size: 24rpx; color: var(--capsule-warm); }

/* 本周学习日历 */
.timeline-section { margin: 20rpx 24rpx; background: var(--capsule-surface); border-radius: 16rpx; padding: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.timeline-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.timeline-title { font-size: 28rpx; font-weight: 600; color: var(--capsule-ink); }
.timeline-total { font-size: 24rpx; color: var(--capsule-accent); font-weight: 600; }
.timeline-grid { display: flex; justify-content: space-between; }
.timeline-cell { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.cell-weekday { font-size: 22rpx; color: var(--capsule-muted); }
.cell-bar {
  width: 40rpx; height: 60rpx; border-radius: 8rpx;
  transition: height 0.3s;
}
.cell-bar.level-0 { height: 12rpx; background: var(--capsule-border); }
.cell-bar.level-1 { height: 24rpx; background: #c7d2fe; }
.cell-bar.level-2 { height: 36rpx; background: #a5b4fc; }
.cell-bar.level-3 { height: 48rpx; background: #818cf8; }
.cell-bar.level-4 { height: 60rpx; background: var(--capsule-accent); }
.cell-bar.level-5 { height: 60rpx; background: var(--capsule-accent); }
.cell-count { font-size: 20rpx; color: var(--capsule-muted); }

/* 统计卡片 */
.stats-grid {
  display: flex; flex-wrap: wrap; margin: 16rpx 24rpx 0;
}
.stat-card {
  width: 25%; padding: 8rpx 6rpx; box-sizing: border-box;
}
.stat-card-inner {
  background: var(--capsule-surface); border-radius: 12rpx; padding: 16rpx 6rpx;
  text-align: center; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.stat-value { font-size: 32rpx; font-weight: 700; color: var(--capsule-ink); }
.stat-label { font-size: 22rpx; color: var(--capsule-muted); margin-top: 4rpx; }

/* 区块 */
.section { margin: 16rpx 24rpx; }
.section-header {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 12rpx;
}
.section-title { font-size: 28rpx; font-weight: 600; color: var(--capsule-ink); }
.section-add-btn {
  font-size: 24rpx; color: var(--capsule-accent); font-weight: 500;
  padding: 6rpx 18rpx; border-radius: 24rpx;
  background: rgba(108, 92, 231, 0.08);
}
.section-action { font-size: 26rpx; color: var(--capsule-accent); }

/* 空状态 */
.empty-state {
  background: var(--capsule-surface); border-radius: 16rpx; padding: 40rpx 32rpx;
  text-align: center; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.empty-text { font-size: 26rpx; color: var(--capsule-muted); display: block; margin-bottom: 20rpx; }
.empty-intro { font-size: 28rpx; color: var(--capsule-ink-secondary); font-weight: 600; display: block; margin-bottom: 6rpx; }
.empty-sub { font-size: 24rpx; color: var(--capsule-muted); display: block; margin-bottom: 16rpx; }

/* 添加课程按钮 */
.add-course-btn, .section-add-btn {
  font-size: 24rpx; color: var(--capsule-accent); font-weight: 500;
  padding: 6rpx 18rpx; border-radius: 24rpx;
  background: rgba(108, 92, 231, 0.08);
  display: inline-block;
}

/* 课程列表 */
.theme-item {
  background: var(--capsule-surface); border-radius: 16rpx; margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); overflow: hidden;
  position: relative;
}
/* 滑动容器 */
.swipe-card {
  padding: 20rpx 24rpx; background: var(--capsule-surface);
}
.swipe-card:active { background: var(--capsule-bg); }
.swipe-delete-btn {
  display: flex; align-items: center; justify-content: center;
  width: 140rpx; height: 100%;
  background: #d54941; color: var(--capsule-surface);
  font-size: 28rpx; font-weight: 500;
}
.theme-top { display: flex; align-items: flex-start; }
.theme-emoji { font-size: 40rpx; margin-right: 14rpx; flex-shrink: 0; margin-top: 2rpx; }
.theme-info { flex: 1; min-width: 0; }
.theme-name { font-size: 28rpx; font-weight: 600; color: var(--capsule-ink); display: flex; align-items: center; gap: 10rpx; }
.theme-status-tag { font-size: 20rpx; padding: 2rpx 10rpx; border-radius: 20rpx; font-weight: 400; }
.theme-status-tag.completed { background: rgba(0, 201, 167, 0.1); color: var(--capsule-success); }
.theme-status-tag.learning { background: #eef2ff; color: var(--capsule-accent); }
.theme-desc { font-size: 24rpx; color: var(--capsule-muted); margin-top: 4rpx; line-height: 1.4; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.theme-progress { display: flex; align-items: center; margin-top: 14rpx; }
.progress-bar {
  flex: 1; height: 6rpx; background: var(--capsule-bg); border-radius: 3rpx;
  margin-right: 12rpx; overflow: hidden;
}
.progress-fill {
  height: 100%; background: linear-gradient(90deg, var(--capsule-accent), var(--capsule-accent-2));
  border-radius: 3rpx; transition: width 0.3s;
}
.progress-text { font-size: 22rpx; color: var(--capsule-muted); flex-shrink: 0; }

.theme-last-node { margin: 8rpx 0 0; }
.theme-last-node text { font-size: 22rpx; color: var(--capsule-muted); }

/* 功能菜单 */
.menu-list {
  background: var(--capsule-surface); border-radius: 16rpx; overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.menu-item {
  display: flex; align-items: center; padding: 28rpx 24rpx;
  border-bottom: 1rpx solid var(--capsule-bg);
}
.menu-item:last-child { border-bottom: none; }
.menu-icon { font-size: 32rpx; margin-right: 20rpx; }
.menu-text { flex: 1; font-size: 28rpx; color: var(--capsule-ink); }
.menu-badge { font-size: 24rpx; color: var(--capsule-accent); background: #f0edff; padding: 4rpx 14rpx; border-radius: 20rpx; margin-right: 12rpx; }
.menu-arrow { font-size: 32rpx; color: var(--capsule-muted); }

/* 底部 */
.footer {
  text-align: center; padding: 40rpx 0 60rpx;
  font-size: 22rpx; color: var(--capsule-muted);
}

