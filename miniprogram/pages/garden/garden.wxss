/* 页面基础 */
.page { height: 100vh; background: #f5f5f7; display: flex; flex-direction: column; }
.scroll { flex: 1; }

/* 加载 */
.loading {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 200rpx 0;
}
.loading-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.loading-text { font-size: 28rpx; color: #999; }

/* 花园头部 */
.garden-header {
  background: linear-gradient(135deg, #1a1a2e, #16213e);
  display: flex; flex-direction: column; align-items: center;
  padding: 50rpx 0 30rpx;
}
.header-plant-wrap {
  display: flex; flex-direction: column; align-items: center;
  margin-bottom: 16rpx;
}
.header-plant { font-size: 80rpx; }
.header-level { font-size: 32rpx; color: #a29bfe; font-weight: 600; }
.header-name { font-size: 24rpx; color: rgba(162,155,254,0.6); margin-top: 4rpx; }
.header-welcome { text-align: center; margin-bottom: 8rpx; }
.header-greeting { font-size: 34rpx; font-weight: 700; color: #fff; display: block; margin-bottom: 4rpx; }
.header-stats { font-size: 24rpx; color: rgba(255,255,255,0.6); display: block; }
.header-points { font-size: 24rpx; color: rgba(255,255,255,0.4); }

/* 下一等级进度 */
.next-level-wrap {
  width: 60%; margin: 12rpx auto 0; text-align: center;
}
.next-level-bar {
  height: 6rpx; background: rgba(255,255,255,0.15); border-radius: 3rpx; overflow: hidden;
}
.next-level-fill {
  height: 100%; background: linear-gradient(90deg, #6c5ce7, #a29bfe);
  border-radius: 3rpx; transition: width 0.5s;
}
.next-level-text { font-size: 20rpx; color: rgba(255,255,255,0.35); margin-top: 6rpx; display: block; }

/* 连续学习 */
.streak-bar {
  display: flex; align-items: center; justify-content: center;
  margin: -10rpx 24rpx 0; padding: 16rpx; background: #fff7ed;
  border-radius: 16rpx; position: relative; z-index: 1;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.streak-icon { font-size: 32rpx; margin-right: 10rpx; }
.streak-text { font-size: 24rpx; color: #c2410c; }

/* 本周学习日历 */
.timeline-section { margin: 20rpx 24rpx; background: #fff; border-radius: 16rpx; padding: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.timeline-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.timeline-title { font-size: 28rpx; font-weight: 600; color: #333; }
.timeline-total { font-size: 24rpx; color: #6c5ce7; font-weight: 600; }
.timeline-grid { display: flex; justify-content: space-between; }
.timeline-cell { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.cell-weekday { font-size: 22rpx; color: #999; }
.cell-bar {
  width: 40rpx; height: 60rpx; border-radius: 8rpx;
  transition: height 0.3s;
}
.cell-bar.level-0 { height: 12rpx; background: #eee; }
.cell-bar.level-1 { height: 24rpx; background: #c7d2fe; }
.cell-bar.level-2 { height: 36rpx; background: #a5b4fc; }
.cell-bar.level-3 { height: 48rpx; background: #818cf8; }
.cell-bar.level-4 { height: 60rpx; background: #6366f1; }
.cell-bar.level-5 { height: 60rpx; background: #4f46e5; }
.cell-count { font-size: 20rpx; color: #999; }

/* 统计卡片 */
.stats-grid {
  display: flex; flex-wrap: wrap; margin: -20rpx 24rpx 0;
  position: relative; z-index: 1;
}
.stat-card {
  width: 25%; padding: 12rpx 8rpx; box-sizing: border-box;
}
.stat-card-inner {
  background: #fff; border-radius: 16rpx; padding: 20rpx 8rpx;
  text-align: center; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.stat-value { font-size: 36rpx; font-weight: 700; color: #1a1a2e; }
.stat-label { font-size: 22rpx; color: #999; margin-top: 4rpx; }

/* 区块 */
.section { margin: 24rpx; }
.section-header {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 16rpx;
}
.section-title { font-size: 30rpx; font-weight: 600; color: #1a1a2e; }
.section-action { font-size: 26rpx; color: #6c5ce7; }

/* 空状态 */
.empty-state {
  background: #fff; border-radius: 16rpx; padding: 60rpx 40rpx;
  text-align: center; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.empty-text { font-size: 26rpx; color: #bbb; display: block; margin-bottom: 20rpx; }
.empty-intro { font-size: 28rpx; color: #666; font-weight: 600; display: block; margin-bottom: 6rpx; }
.empty-sub { font-size: 24rpx; color: #999; display: block; margin-bottom: 24rpx; }

/* 生成新课卡片 */
.new-theme-card {
  display: flex; align-items: center; justify-content: center;
  padding: 24rpx; margin: 0 24rpx 16rpx;
  background: linear-gradient(135deg, #f0edff, #e8e4ff);
  border-radius: 20rpx; font-size: 28rpx; color: #6c5ce7; font-weight: 600;
  box-shadow: 0 2rpx 12rpx rgba(108,92,231,0.12);
}

/* 课程列表 */
.theme-item {
  background: #fff; border-radius: 16rpx; padding: 24rpx;
  margin-bottom: 16rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.theme-top { display: flex; align-items: flex-start; margin-bottom: 16rpx; }
.theme-emoji { font-size: 48rpx; margin-right: 16rpx; flex-shrink: 0; }
.theme-info { flex: 1; }
.theme-name { font-size: 28rpx; font-weight: 600; color: #1a1a2e; }
.theme-desc { font-size: 24rpx; color: #999; margin-top: 4rpx; line-height: 1.4; }

.theme-progress { display: flex; align-items: center; margin-bottom: 16rpx; }
.progress-bar {
  flex: 1; height: 8rpx; background: #f0f0f0; border-radius: 4rpx;
  margin-right: 12rpx; overflow: hidden;
}
.progress-fill {
  height: 100%; background: linear-gradient(90deg, #6c5ce7, #a29bfe);
  border-radius: 4rpx; transition: width 0.3s;
}
.progress-text { font-size: 22rpx; color: #999; flex-shrink: 0; }

.theme-last-node { margin: 0 0 12rpx; }
.theme-last-node text { font-size: 22rpx; color: #bbb; }

.theme-actions { display: flex; gap: 12rpx; }
.btn {
  flex: 1; height: 64rpx; border-radius: 32rpx; font-size: 26rpx;
  display: flex; align-items: center; justify-content: center;
}
.btn.primary {
  background: linear-gradient(135deg, #6c5ce7, #a29bfe); color: #fff;
}
.btn.secondary {
  background: #f5f5f7; color: #666;
}

/* 功能菜单 */
.menu-list {
  background: #fff; border-radius: 16rpx; overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.menu-item {
  display: flex; align-items: center; padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f7;
}
.menu-item:last-child { border-bottom: none; }
.menu-icon { font-size: 32rpx; margin-right: 20rpx; }
.menu-text { flex: 1; font-size: 28rpx; color: #333; }
.menu-badge { font-size: 24rpx; color: #6c5ce7; background: #f0edff; padding: 4rpx 14rpx; border-radius: 20rpx; margin-right: 12rpx; }
.menu-arrow { font-size: 32rpx; color: #ccc; }

/* 底部 */
.footer {
  text-align: center; padding: 40rpx 0 60rpx;
  font-size: 22rpx; color: #ccc;
}
