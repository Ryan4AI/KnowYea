/* pages/feedback/feedback.wxss */
@import "../../styles/pages.wxss";

.feedback-textarea {
  width: 100%;
  height: 240rpx;
  background: var(--capsule-bg);
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: var(--capsule-ink);
  box-sizing: border-box;
  line-height: 1.6;
}

.feedback-input {
  width: 100%;
  background: var(--capsule-bg);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--capsule-ink);
  box-sizing: border-box;
}

.word-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: var(--capsule-muted);
  margin-top: 8rpx;
}
