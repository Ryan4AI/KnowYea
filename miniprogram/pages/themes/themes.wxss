/* pages/themes/themes.wxss */

.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #eef0fb 0%, #f4f6fc 40%, #f8f9fc 100%);
}

.theme-list {
  padding: 20rpx;
}

.theme-item {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(26, 29, 46, 0.06);
  border: 1rpx solid rgba(26, 29, 46, 0.05);
}

.theme-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.theme-cover {
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #6c5ce7 0%, #a29bfe 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 48rpx;
  margin-right: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(108, 92, 231, 0.25);
}

.theme-info {
  flex: 1;
}

.theme-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.theme-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.theme-status {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.theme-status.learning {
  background: #e8f5e9;
  color: #4CAF50;
}

.theme-status.completed {
  background: #fff3e0;
  color: #ff9800;
}

.theme-progress {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-bar {
  flex: 1;
  height: 12rpx;
  background: #e8ecf0;
  border-radius: 6rpx;
  margin-right: 20rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #6c5ce7 0%, #a29bfe 50%, #00c9a7 100%);
  border-radius: 6rpx;
  transition: width 0.35s ease;
}

.progress-text {
  font-size: 24rpx;
  color: #666;
  min-width: 100rpx;
  text-align: right;
}

.theme-plant {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.plant-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.plant-info {
  flex: 1;
}

.plant-name {
  font-size: 26rpx;
  color: #666;
}

.plant-points {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.theme-actions {
  display: flex;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  flex: 1;
  padding: 16rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  text-align: center;
  margin: 0 8rpx;
}

.action-btn.continue {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.action-btn.review {
  background: #f5f7fa;
  color: #666;
}

.action-btn.delete {
  background: #ffebee;
  color: #f44336;
}

/* 添加主题按钮 */
.add-theme-btn {
  position: fixed;
  bottom: 40rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 600rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-radius: 44rpx;
  padding: 24rpx;
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(102, 126, 234, 0.4);
}

.add-icon {
  margin-right: 12rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  color: #999;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  text-align: center;
  margin-bottom: 40rpx;
}

.empty-add-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  padding: 20rpx 48rpx;
}

.empty-add-btn::after {
  border: none;
}

/* 底部留白 */
.bottom-spacer {
  height: 120rpx;
}