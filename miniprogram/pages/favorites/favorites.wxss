.page-container { min-height: 100vh; background: var(--capsule-bg); }
.loading { display: flex; align-items: center; justify-content: center; padding: 100rpx; color: var(--capsule-muted); }
.loading-icon { font-size: 40rpx; margin-right: 16rpx; animation: rotate 1s linear infinite; }
@keyframes rotate { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
.empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 120rpx 40rpx; }
.empty-icon { font-size: 100rpx; margin-bottom: 30rpx; }
.empty-text { font-size: 28rpx; color: var(--capsule-muted); text-align: center; }
.favorites-list { padding: 20rpx; }
.favorite-item { background: var(--capsule-surface); border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx; display: flex; align-items: center; }
.item-content { flex: 1; }
.item-title { font-size: 28rpx; font-weight: bold; color: var(--capsule-ink); }
.item-meta { font-size: 22rpx; color: var(--capsule-muted); margin-top: 8rpx; }
.remove-btn { background: #ffebee; color: #f44336; border-radius: 20rpx; padding: 8rpx 20rpx; font-size: 22rpx; }
