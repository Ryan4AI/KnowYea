/* 学习历史页 */
.page-container {
  min-height: 100vh;
  background: var(--capsule-bg);
  padding: 24rpx 0;
}

.loading, .empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 40rpx;
  color: #999;
  font-size: 28rpx;
  line-height: 1.6;
  text-align: center;
}

.loading-icon, .empty-icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
}

/* 日期分组 */
.date-group {
  margin-bottom: 32rpx;
}

.date-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #999;
  padding: 0 32rpx;
  margin-bottom: 16rpx;
}

.date-items {
  position: relative;
  padding-left: 32rpx;
}

/* 时间线竖线 */
.date-items::before {
  content: '';
  position: absolute;
  left: 48rpx;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background: #e8e8eb;
}

.history-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 32rpx 20rpx 0;
  background: #fff;
  margin-bottom: 2rpx;
  position: relative;
}

.history-item:active {
  background: #f8f8fa;
}

/* 时间线圆点 */
.item-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #667eea;
  margin-top: 10rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}

.item-content {
  flex: 1;
  min-width: 0;
}

.item-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--capsule-ink);
  line-height: 1.4;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-meta {
  font-size: 22rpx;
  color: #999;
  line-height: 1.4;
}

.item-time {
  font-size: 22rpx;
  color: #bbb;
  flex-shrink: 0;
  margin-left: 12rpx;
  margin-top: 2rpx;
}
