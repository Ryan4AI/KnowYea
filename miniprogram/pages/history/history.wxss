.page-container { min-height: 100vh; background: #f5f5f5; }
.loading { display: flex; align-items: center; justify-content: center; padding: 100rpx; color: #999; }
.loading-icon { font-size: 40rpx; margin-right: 16rpx; animation: rotate 1s linear infinite; }
@keyframes rotate { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
.empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 120rpx 40rpx; }
.empty-icon { font-size: 100rpx; margin-bottom: 30rpx; }
.empty-text { font-size: 28rpx; color: #999; text-align: center; }
.history-list { padding: 20rpx; }
.history-item { background: white; border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx; display: flex; align-items: center; }
.item-left { flex: 1; }
.item-title { font-size: 28rpx; font-weight: bold; color: #333; }
.item-meta { font-size: 22rpx; color: #999; margin-top: 8rpx; }
.item-arrow { font-size: 32rpx; color: #ccc; }
