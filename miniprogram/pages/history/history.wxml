<view class="page-container">
  <view class="loading" wx:if="{{isLoading}}">
    <text class="loading-icon">⏳</text>
    <text>加载中...</text>
  </view>
  <view class="empty-state" wx:elif="{{historyList.length === 0}}">
    <text class="empty-icon">📜</text>
    <text class="empty-text">还没有学习记录\n开始学习后记录会显示在这里</text>
  </view>
  <view class="history-list" wx:else>
    <view class="history-item" wx:for="{{historyList}}" wx:key="_id" bindtap="onItemTap" data-theme-id="{{item.themeId}}" data-node-id="{{item.nodeId}}">
      <view class="item-left">
        <view class="item-title">{{item.nodeTitle}}</view>
        <view class="item-meta">{{item.themeName}} · 课时 {{item.nodeOrder}}</view>
      </view>
      <view class="item-arrow">›</view>
    </view>
  </view>
</view>
