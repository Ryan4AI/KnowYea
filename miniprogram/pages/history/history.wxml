<view class="page-container">
  <view class="loading" wx:if="{{isLoading}}">
    <text class="loading-icon">⏳</text>
    <text>加载中...</text>
  </view>

  <view class="empty-state" wx:elif="{{historyList.length === 0}}">
    <text class="empty-icon">📜</text>
    <text class="empty-text">还没有学习记录\n开始学习后记录会显示在这里</text>
  </view>

  <!-- 按日期分组的时间线 -->
  <view class="history-list" wx:else>
    <view class="date-group" wx:for="{{groupedHistory}}" wx:key="dateLabel">
      <view class="date-label">{{item.dateLabel}}</view>
      <view class="date-items">
        <view class="history-item" wx:for="{{item.items}}" wx:key="_id" wx:for-item="record" bindtap="onItemTap" data-course-id="{{record.courseId}}" data-lesson-id="{{record.lessonId}}">
          <view class="item-dot"></view>
          <view class="item-content">
            <view class="item-title">{{record.nodeTitle}}</view>
            <view class="item-meta">{{record.themeName}} · 第 {{record.nodeOrder}} 课</view>
          </view>
          <view class="item-time">{{record.timeStr}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
