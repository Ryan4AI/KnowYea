/* pages/feedback-admin/feedback-admin.wxss */
@import "../../styles/pages.wxss";

.filter-bar {
  display: flex;
  gap: 16rpx;
  padding: 0 32rpx 24rpx;
}

.filter-tab {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--capsule-ink-secondary);
  background: var(--capsule-bg);
  border-radius: 32rpx;
  transition: all 0.2s;
}

.filter-tab.active {
  color: #fff;
  background: var(--capsule-accent);
}

.feedback-list {
  padding: 0 32rpx 40rpx;
  max-height: calc(100vh - 400rpx);
}

.feedback-card {
  background: var(--capsule-surface);
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--capsule-shadow);
}

.card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.card-content-preview {
  flex: 1;
  font-size: 28rpx;
  color: var(--capsule-ink);
  line-height: 1.5;
}

.status-badge {
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

.status-new { background: #fff3e0; color: #e65100; }
.status-viewed { background: #e3f2fd; color: #1565c0; }
.status-resolved { background: #e8f5e9; color: #2e7d32; }
.status-wontfix { background: #f3e5f5; color: #7b1fa2; }

.card-meta {
  display: flex;
  gap: 24rpx;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--capsule-muted);
}

.card-detail {
  margin-top: 16rpx;
}

.detail-divider {
  height: 2rpx;
  background: var(--capsule-border);
  margin-bottom: 16rpx;
}

.detail-content {
  font-size: 28rpx;
  color: var(--capsule-ink);
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}

.detail-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.action-btn {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  border-radius: 12rpx;
  text-align: center;
  border: none;
}

.action-resolved { background: #e8f5e9; color: #2e7d32; }
.action-wontfix { background: #f3e5f5; color: #7b1fa2; }
.action-viewed { background: #e3f2fd; color: #1565c0; }

.loading-tip,
.empty-tip {
  text-align: center;
  padding: 120rpx 0;
  color: var(--capsule-muted);
  font-size: 28rpx;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}
