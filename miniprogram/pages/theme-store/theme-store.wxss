/* pages/theme-store/theme-store.wxss */
@import "../../styles/pages.wxss";
@import "../../styles/gen-loading.wxss";

/* 加载中 */
.loading {
  text-align: center;
  padding: 80rpx 0;
  font-size: 28rpx;
  color: #999;
}

/* 输入区 */
.input-wrap {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.input-field {
  flex: 1;
  background: #f5f5f7;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  height: 72rpx;
  box-sizing: border-box;
}

.gen-btn {
  flex-shrink: 0;
  height: 72rpx;
  line-height: 72rpx;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 16rpx;
  padding: 0 24rpx;
  text-align: center;
  border: none;
}

.gen-btn[disabled] {
  background: #d1d5db;
  color: #999;
}

/* 示例标签 */
.examples { margin-top: 8rpx; }
.examples-label { font-size: 24rpx; color: #bbb; margin-bottom: 12rpx; display: block; }
.example-tags { display: flex; flex-wrap: wrap; gap: 12rpx; }
.example-tag {
  background: #f5f5f7;
  border-radius: 30rpx;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: #666;
}

/* 结果弹窗按钮 */
.gen-learn-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #6366f1;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  text-align: center;
  border: none;
}

.gen-again-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #f5f5f7;
  color: #666;
  font-size: 28rpx;
  border-radius: 16rpx;
  margin-top: 16rpx;
  text-align: center;
  border: none;
}
