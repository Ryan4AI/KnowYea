/* pages/theme-store/theme-store.wxss */

.page-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
}

/* 搜索区域 */
.search-area {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  background: #f5f7fa;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 48rpx;
}

/* 推荐区域 */
.recommend-section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding: 0 10rpx;
}

.theme-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.theme-card {
  width: 48%;
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.theme-cover {
  width: 100%;
  height: 160rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.theme-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.theme-desc {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.theme-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #999;
}

.add-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-radius: 30rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
}

.add-btn.added {
  background: #e8f5e9;
  color: #4CAF50;
}

/* 分类标签 */
.category-tabs {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 10rpx;
  background: white;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.tab-item {
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  margin: 8rpx;
  background: #f5f7fa;
  color: #666;
}

.tab-item.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

/* AI 推荐 */
.ai-recommend {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  color: white;
}

.ai-recommend-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.ai-recommend-input {
  background: rgba(255,255,255,0.2);
  border-radius: 40rpx;
  padding: 20rpx 28rpx;
  display: flex;
  align-items: center;
}

.ai-recommend-input input {
  flex: 1;
  font-size: 28rpx;
  color: white;
  height: 48rpx;
}

.ai-recommend-input input::placeholder {
  color: rgba(255,255,255,0.7);
}

.ai-recommend-btn {
  background: white;
  color: #667eea;
  border-radius: 30rpx;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  font-weight: bold;
}

/* Loading */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
  color: #999;
}

.loading-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
  animation: rotate 1s linear infinite;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}