/* pages/theme-store/theme-store.wxss */
@import "../../styles/pages.wxss";
@import "../../styles/gen-loading.wxss";

/* 加载中 */
.loading {
  text-align: center;
  padding: 80rpx 0;
  font-size: 28rpx;
  color: var(--capsule-muted);
}

/* 输入区 */
.input-wrap {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.input-field {
  flex: 1;
  background: var(--capsule-bg);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  height: 72rpx;
  box-sizing: border-box;
}

.gen-btn {
  flex-shrink: 0;
  height: 72rpx;
  line-height: 72rpx;
  background: linear-gradient(135deg, var(--capsule-accent), var(--capsule-accent-2));
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 16rpx;
  padding: 0 24rpx;
  text-align: center;
  border: none;
}

.gen-btn[disabled] {
  background: var(--capsule-border);
  color: var(--capsule-muted);
}

/* 示例标签 */
.examples { margin-top: 8rpx; }
.examples-label { font-size: 24rpx; color: var(--capsule-muted); margin-bottom: 12rpx; display: block; }
.example-tags { display: flex; flex-wrap: wrap; gap: 12rpx; }
.example-tag {
  background: var(--capsule-bg);
  border-radius: 30rpx;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: var(--capsule-ink-secondary);
}

/* 结果弹窗按钮 */
.gen-learn-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--capsule-accent);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  text-align: center;
  border: none;
}

.gen-again-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: var(--capsule-bg);
  color: var(--capsule-ink-secondary);
  font-size: 28rpx;
  border-radius: 16rpx;
  margin-top: 16rpx;
  text-align: center;
  border: none;
}

/* 内联样式提取类 */
.section-desc { font-size: 26rpx; color: var(--capsule-muted); margin-bottom: 40rpx; line-height: 1.6; }
.theme-desc-text { font-size: 26rpx; color: var(--capsule-ink-secondary); margin-bottom: 12rpx; padding: 0 20rpx; line-height: 1.5; }
.theme-meta { font-size: 24rpx; color: var(--capsule-muted); margin-bottom: 32rpx; }
