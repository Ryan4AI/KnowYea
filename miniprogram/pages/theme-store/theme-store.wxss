/* pages/theme-store/theme-store.wxss */

.page-container {
  min-height: 100vh;
  background: #f4f6fc;
  padding-bottom: 40rpx;
}

/* ===== AI 生成区域 ===== */
.ai-section {
  background: linear-gradient(135deg, #1a1a2e, #16213e);
  padding: 40rpx 24rpx 30rpx;
}
.ai-title { font-size: 28rpx; font-weight: 700; color: #fff; margin-bottom: 20rpx; }
.ai-input-wrap {
  display: flex; align-items: center;
  background: rgba(255,255,255,0.12);
  border-radius: 40rpx; padding: 16rpx 20rpx;
}
.ai-input { flex: 1; font-size: 26rpx; color: #fff; height: 48rpx; }
.ai-btn {
  background: #fff; color: #6c5ce7; border-radius: 30rpx;
  padding: 12rpx 28rpx; font-size: 24rpx; font-weight: 700;
  flex-shrink: 0; margin-left: 12rpx;
}

/* 生成结果 */
.ai-result {
  display: flex; align-items: center;
  margin-top: 20rpx; background: rgba(255,255,255,0.1);
  border-radius: 16rpx; padding: 20rpx;
}
.result-icon { font-size: 36rpx; margin-right: 14rpx; }
.result-info { flex: 1; }
.result-name { font-size: 26rpx; font-weight: 600; color: #fff; }
.result-desc { font-size: 22rpx; color: rgba(255,255,255,0.6); margin-top: 4rpx; }
.result-btn {
  background: #a29bfe; color: #fff; border-radius: 30rpx;
  padding: 12rpx 24rpx; font-size: 22rpx; font-weight: 600;
  flex-shrink: 0;
}

/* ===== 搜索 ===== */
.search-area { margin: 0 24rpx; margin-top: -20rpx; position: relative; z-index: 1; }
.search-input-wrapper {
  display: flex; align-items: center;
  background: #fff; border-radius: 40rpx;
  padding: 16rpx 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.search-icon { font-size: 28rpx; margin-right: 12rpx; }
.search-input { flex: 1; font-size: 26rpx; height: 48rpx; }

/* ===== 分类标签 ===== */
.category-tabs {
  display: flex; flex-wrap: wrap;
  padding: 16rpx 24rpx; gap: 12rpx;
}
.tab-item {
  padding: 10rpx 24rpx; border-radius: 30rpx; font-size: 24rpx;
  background: #fff; color: #666; box-shadow: 0 1rpx 6rpx rgba(0,0,0,0.04);
  position: relative;
}
.tab-item.active {
  background: linear-gradient(135deg, #6c5ce7, #a29bfe);
  color: #fff;
}
.tab-item.recommended { border: 2rpx solid #a29bfe; }
.tag-hint {
  font-size: 18rpx; background: #6c5ce7; color: #fff;
  padding: 2rpx 10rpx; border-radius: 12rpx;
  margin-left: 6rpx; vertical-align: super;
}

/* ===== 课程网格 ===== */
.theme-grid {
  display: flex; flex-wrap: wrap;
  padding: 0 24rpx; gap: 20rpx;
}
.theme-card {
  width: calc(50% - 10rpx);
  background: #fff; border-radius: 20rpx; padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.theme-cover {
  width: 100%; height: 140rpx; border-radius: 14rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  display: flex; align-items: center; justify-content: center;
  font-size: 56rpx; margin-bottom: 16rpx;
}
.theme-name { font-size: 28rpx; font-weight: 700; color: #333; margin-bottom: 8rpx; }
.theme-desc {
  font-size: 22rpx; color: #999; margin-bottom: 14rpx;
  overflow: hidden; text-overflow: ellipsis;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
}
.theme-meta { display: flex; justify-content: space-between; align-items: center; }
.theme-meta text { font-size: 22rpx; color: #999; }
.add-btn {
  background: linear-gradient(135deg, #6c5ce7, #a29bfe); color: #fff;
  border-radius: 30rpx; padding: 10rpx 22rpx; font-size: 22rpx;
}
.add-btn.added { background: #f0edff; color: #6c5ce7; }

/* ===== Loading ===== */
.loading { display: flex; justify-content: center; padding: 60rpx; color: #999; font-size: 26rpx; }

/* ===== 空状态 ===== */
.empty-state { text-align: center; padding: 80rpx 40rpx; }
.empty-icon { font-size: 64rpx; display: block; margin-bottom: 20rpx; }
.empty-text { font-size: 28rpx; color: #999; display: block; margin-bottom: 12rpx; }
.empty-hint { font-size: 24rpx; color: #bbb; display: block; }
