/* pages/theme-store/theme-store.wxss — AI 课程生成器 */

.page-container {
  min-height: 100vh;
  background: #f4f6fc;
  padding: 40rpx 32rpx;
}

/* ===== 头部 ===== */
.hero-section { text-align: center; padding: 60rpx 0 50rpx; }
.hero-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.hero-title { font-size: 36rpx; font-weight: 700; color: #1a1a2e; margin-bottom: 12rpx; }
.hero-desc { font-size: 26rpx; color: #999; line-height: 1.5; }

/* ===== 输入区 ===== */
.input-wrap {
  background: #fff; border-radius: 24rpx; padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}
.input-field {
  width: 100%; height: 80rpx; font-size: 30rpx;
  border: none; outline: none; margin-bottom: 20rpx;
}
.gen-btn {
  width: 100%; height: 88rpx;
  background: linear-gradient(135deg, #6c5ce7, #a29bfe);
  color: #fff; border-radius: 44rpx; font-size: 30rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}

/* ===== 示例标签 ===== */
.examples { margin-top: 32rpx; }
.examples-label { font-size: 24rpx; color: #999; display: block; margin-bottom: 14rpx; }
.example-tags { display: flex; flex-wrap: wrap; gap: 14rpx; }
.example-tag {
  padding: 10rpx 24rpx; border-radius: 30rpx; font-size: 24rpx;
  background: #fff; color: #6c5ce7; box-shadow: 0 1rpx 8rpx rgba(0,0,0,0.06);
}

/* ===== 结果卡片 ===== */
.result-section { display: flex; justify-content: center; padding-top: 40rpx; }
.result-card {
  width: 100%; background: #fff; border-radius: 24rpx;
  padding: 48rpx 32rpx; text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}
.result-icon { font-size: 72rpx; margin-bottom: 20rpx; }
.result-name { font-size: 36rpx; font-weight: 700; color: #1a1a2e; margin-bottom: 12rpx; }
.result-desc { font-size: 26rpx; color: #999; margin-bottom: 36rpx; }
.learn-btn {
  width: 80%; height: 88rpx;
  background: linear-gradient(135deg, #6c5ce7, #a29bfe);
  color: #fff; border-radius: 44rpx; font-size: 30rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 16rpx;
}
.again-btn {
  width: 80%; height: 72rpx;
  background: transparent; border: 2rpx solid #ddd; border-radius: 36rpx;
  font-size: 26rpx; color: #999;
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto;
}
