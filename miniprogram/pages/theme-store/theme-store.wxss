/* pages/theme-store/theme-store.wxss */
@import "../../styles/pages.wxss";

/* 加载中 */
.loading {
  text-align: center;
  padding: 80rpx 0;
  font-size: 28rpx;
  color: #999;
}

/* 输入区 */
.input-wrap {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.input-field {
  flex: 1;
  background: #f5f5f7;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  height: 72rpx;
  box-sizing: border-box;
}

.gen-btn {
  flex-shrink: 0;
  height: 72rpx;
  line-height: 72rpx;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 16rpx;
  padding: 0 24rpx;
  text-align: center;
  border: none;
}

.gen-btn[disabled] {
  background: #d1d5db;
  color: #999;
}

/* 示例标签 */
.examples { margin-top: 8rpx; }
.examples-label { font-size: 24rpx; color: #bbb; margin-bottom: 12rpx; display: block; }
.example-tags { display: flex; flex-wrap: wrap; gap: 12rpx; }
.example-tag {
  background: #f5f5f7;
  border-radius: 30rpx;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: #666;
}

/* 生成结果 */
.result-card {
  text-align: center;
}
.result-icon { font-size: 72rpx; margin-bottom: 16rpx; }
.result-name { font-size: 34rpx; font-weight: 700; color: #1a1a2e; margin-bottom: 12rpx; }
.result-desc { font-size: 26rpx; color: #999; margin-bottom: 40rpx; }
