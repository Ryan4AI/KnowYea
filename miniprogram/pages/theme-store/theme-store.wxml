<!-- pages/theme-store/theme-store.wxml — AI 课程生成器 -->
<view class="page">
<view class="page-container">

  <!-- 头部 -->
  <view class="page-header">
    <view class="page-icon">🧠</view>
    <view class="page-title">AI 课程生成器</view>
    <view class="page-desc">输入你想学的内容，AI 为你量身定制一套完整课程</view>
  </view>

  <!-- 加载中 -->
  <view class="loading" wx:if="{{!profileLoaded}}">
    <text>加载中...</text>
  </view>

  <!-- 未设置画像 -->
  <view wx:elif="{{profileLoaded && !userProfile}}">
    <view class="white-card centered" style="max-width: 640rpx; margin: 0 auto;">
      <view style="font-size: 72rpx; margin-bottom: 16rpx;">👤</view>
      <view style="font-size: 32rpx; font-weight: 600; color: var(--capsule-ink); margin-bottom: 12rpx;">先填写基本信息</view>
      <view style="font-size: 26rpx; color: #999; margin-bottom: 40rpx; line-height: 1.6;">AI 需要了解你的年龄、职业和兴趣，才能为你定制课程</view>
      <button class="btn-primary" bindtap="onGoProfile">去设置 →</button>
    </view>
  </view>

  <!-- 输入区（有画像时始终可见） -->
  <view wx:elif="{{userProfile}}">
    <view class="white-card">
      <view class="input-wrap">
        <input class="input-field" placeholder="例如：投资理财、心理学入门、AI基础知识..." placeholder-style="color: #999" bindinput="onAIInput" bindconfirm="onAIRecommend" value="{{aiKeyword}}" />
        <button class="gen-btn" bindtap="onAIRecommend" disabled="{{isGenerating}}">{{isGenerating ? '⏳ 生成中...' : '🚀 生成课程'}}</button>
      </view>
      <view class="examples" wx:if="{{interestTags.length > 0}}">
        <text class="examples-label">你的兴趣方向：</text>
        <view class="example-tags">
          <text class="example-tag" wx:for="{{interestTags}}" wx:key="index" bindtap="onExample" data-keyword="{{item}}">{{item}}</text>
        </view>
      </view>
    </view>
  </view>
</view>

  <!-- 生成进度弹窗 -->
  <view class="gen-mask" wx:if="{{isGenerating}}">
    <view class="gen-card">
      <view class="gen-icon">🧠</view>
      <view class="gen-title">AI 正在为你生成课程</view>
      <view class="gen-stage">{{genStage}}</view>
      <view class="gen-bar">
        <view class="gen-fill" style="width: {{genProgress}}%"></view>
      </view>
      <view class="gen-hint">根据内容复杂度可能需要 10-30 秒</view>
    </view>
  </view>

  <!-- 生成完成弹窗 -->
  <view class="gen-mask" wx:if="{{newTheme && !isGenerating}}">
    <view class="gen-card">
      <view style="font-size: 72rpx; margin-bottom: 16rpx;">✅</view>
      <view class="gen-title">{{newTheme.name}}</view>
      <view style="font-size: 26rpx; color: #666; margin-bottom: 12rpx; padding: 0 20rpx; line-height: 1.5;">{{newTheme.desc}}</view>
      <view style="font-size: 24rpx; color: #bbb; margin-bottom: 32rpx;" wx:if="{{newTheme.nodesCount}}">共 {{newTheme.nodesCount}} 节课 · 每节 3-5 分钟</view>
      <button class="gen-learn-btn" bindtap="onGoLearn">开始学习 →</button>
      <button class="gen-again-btn" bindtap="onReset">再生成一个</button>
    </view>
  </view>
</view>
