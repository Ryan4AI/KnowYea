<!-- pages/theme-store/theme-store.wxml — AI 课程生成器 -->
<view class="page-container">
  <view class="hero-section">
    <view class="hero-icon">🧠</view>
    <view class="hero-title">AI 课程生成器</view>
    <view class="hero-desc">输入你想学的内容，AI 为你量身定制一套完整课程</view>
  </view>

  <!-- 输入区 -->
  <view class="input-area" wx:if="{{!newTheme}}">
    <view class="input-wrap">
      <input
        class="input-field"
        placeholder="例如：投资理财、心理学入门、AI基础知识..."
        placeholder-style="color: #999"
        bindinput="onAIInput"
        bindconfirm="onAIRecommend"
        value="{{aiKeyword}}"
      />
      <button class="gen-btn" bindtap="onAIRecommend" disabled="{{isGenerating}}">
        {{isGenerating ? '⏳ 生成中...' : '🚀 生成课程'}}
      </button>
    </view>

    <!-- 示例 -->
    <view class="examples">
      <text class="examples-label">试试这些方向：</text>
      <view class="example-tags">
        <text class="example-tag" bindtap="onExample" data-keyword="投资理财">投资理财</text>
        <text class="example-tag" bindtap="onExample" data-keyword="心理学">心理学</text>
        <text class="example-tag" bindtap="onExample" data-keyword="AI入门">AI入门</text>
        <text class="example-tag" bindtap="onExample" data-keyword="沟通技巧">沟通技巧</text>
        <text class="example-tag" bindtap="onExample" data-keyword="思维模型">思维模型</text>
      </view>
    </view>
  </view>

  <!-- 生成结果 -->
  <view class="result-section" wx:if="{{newTheme}}">
    <view class="result-card">
      <view class="result-icon">✅</view>
      <view class="result-name">{{newTheme.name}}</view>
      <view class="result-desc">课程已生成，AI 正在为你准备第一节课</view>
      <button class="learn-btn" bindtap="onGoLearn">开始学习 →</button>
      <button class="again-btn" bindtap="onReset">再生成一个</button>
    </view>
  </view>
</view>
