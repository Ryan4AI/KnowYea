<!-- pages/theme-store/theme-store.wxml — AI 课程生成器 -->
<view class="page">
<view class="page-container">

  <!-- 头部 -->
  <view class="page-header">
    <view class="page-icon">🧠</view>
    <view class="page-title">AI 课程生成器</view>
    <view class="page-desc">输入你想学的内容，AI 为你量身定制一套完整课程</view>
  </view>

  <!-- 加载中 -->
  <view class="loading" wx:if="{{!profileLoaded}}">
    <text>加载中...</text>
  </view>

  <!-- 未设置画像 -->
  <view wx:elif="{{profileLoaded && !userProfile}}">
    <view class="white-card centered" style="max-width: 640rpx; margin: 0 auto;">
      <view class="missing-icon" style="font-size: 72rpx; margin-bottom: 16rpx;">👤</view>
      <view style="font-size: 32rpx; font-weight: 600; color: #1a1a2e; margin-bottom: 12rpx;">先设置个人画像</view>
      <view style="font-size: 26rpx; color: #999; margin-bottom: 40rpx; line-height: 1.6;">AI 需要了解你的年龄、职业和兴趣，才能为你定制课程</view>
      <button class="btn-primary" bindtap="onGoProfile">去设置 →</button>
    </view>
  </view>

  <!-- 输入区 -->
  <view wx:elif="{{userProfile && !newTheme}}">
    <view class="white-card">
      <view class="input-wrap">
        <input class="input-field" placeholder="例如：投资理财、心理学入门、AI基础知识..." placeholder-style="color: #999" bindinput="onAIInput" bindconfirm="onAIRecommend" value="{{aiKeyword}}" />
        <button class="gen-btn" bindtap="onAIRecommend" disabled="{{isGenerating}}">{{isGenerating ? '⏳ 生成中...' : '🚀 生成课程'}}</button>
      </view>
      <view class="examples">
        <text class="examples-label">试试这些方向：</text>
        <view class="example-tags">
          <text class="example-tag" bindtap="onExample" data-keyword="投资理财">投资理财</text>
          <text class="example-tag" bindtap="onExample" data-keyword="心理学">心理学</text>
          <text class="example-tag" bindtap="onExample" data-keyword="AI入门">AI入门</text>
          <text class="example-tag" bindtap="onExample" data-keyword="沟通技巧">沟通技巧</text>
          <text class="example-tag" bindtap="onExample" data-keyword="思维模型">思维模型</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 生成结果 -->
  <view wx:elif="{{userProfile && newTheme}}">
    <view class="white-card centered" style="max-width: 640rpx; margin: 0 auto;">
      <view style="font-size: 72rpx; margin-bottom: 16rpx;">✅</view>
      <view style="font-size: 34rpx; font-weight: 700; color: #1a1a2e; margin-bottom: 12rpx;">{{newTheme.name}}</view>
      <view style="font-size: 26rpx; color: #999; margin-bottom: 40rpx;">课程已生成，AI 正在为你准备第一节课</view>
      <button class="btn-primary" bindtap="onGoLearn">开始学习 →</button>
      <button class="btn-secondary" bindtap="onReset">再生成一个</button>
    </view>
  </view>
</view>
</view>
